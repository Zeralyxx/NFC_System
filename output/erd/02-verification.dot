digraph ERD { graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.9, splines=polyline, concentrate=false, outputorder=edgesfirst]; node [shape=plain, fontname="Arial", fontsize=14]; edge [arrowsize=0.8, penwidth=1.2]; fast_mode_logs [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#F7E4BB"><B>FAST_MODE_LOGS</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, AI, NN</FONT></TD></TR><TR><TD PORT="timestamp" ALIGN="LEFT">timestamp</TD><TD ALIGN="LEFT">DATETIME(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NULL</FONT></TD></TR><TR><TD PORT="student_name" ALIGN="LEFT">student_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="nfc_uid" ALIGN="LEFT">nfc_uid</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="transaction_type" ALIGN="LEFT">transaction_type</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="verification_mode" ALIGN="LEFT">verification_mode</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="is_granted" ALIGN="LEFT">is_granted</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="error_code" ALIGN="LEFT">error_code</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="error_message" ALIGN="LEFT">error_message</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="remarks" ALIGN="LEFT">remarks</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="nfc_system_ms" ALIGN="LEFT">nfc_system_ms</TD><TD ALIGN="LEFT">DOUBLE</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="pin_workflow_ms" ALIGN="LEFT">pin_workflow_ms</TD><TD ALIGN="LEFT">DOUBLE</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="pin_system_ms" ALIGN="LEFT">pin_system_ms</TD><TD ALIGN="LEFT">DOUBLE</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="qr_workflow_ms" ALIGN="LEFT">qr_workflow_ms</TD><TD ALIGN="LEFT">DOUBLE</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="qr_system_ms" ALIGN="LEFT">qr_system_ms</TD><TD ALIGN="LEFT">DOUBLE</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="total_workflow_ms" ALIGN="LEFT">total_workflow_ms</TD><TD ALIGN="LEFT">DOUBLE</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="total_system_ms" ALIGN="LEFT">total_system_ms</TD><TD ALIGN="LEFT">DOUBLE</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="db_query_speed_ms" ALIGN="LEFT">db_query_speed_ms</TD><TD ALIGN="LEFT">DOUBLE</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="synced_to_cloud" ALIGN="LEFT">synced_to_cloud</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT">device_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="device_name" ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
