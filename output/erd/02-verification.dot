attendance_devices [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#EDF0F2"><B>ATTENDANCE_DEVICES</B><BR/><FONT POINT-SIZE="11">REFERENCE ONLY</FONT></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT">device_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR></TABLE>>]; { rank=same; students; attendance_devices; } students:s -> fast_mode_logs:n [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#357052", style=dashed];
