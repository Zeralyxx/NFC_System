digraph ERD { graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.9, splines=polyline, concentrate=false, outputorder=edgesfirst]; node [shape=plain, fontname="Arial", fontsize=14]; edge [arrowsize=0.8, penwidth=1.2]; students [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DBEEE3"><B>STUDENTS</B></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR><TR><TD PORT="full_name" ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(150)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="course" ALIGN="LEFT">course</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NULL</FONT></TD></TR><TR><TD PORT="year_level" ALIGN="LEFT">year_level</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="section_name" ALIGN="LEFT">section_name</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="nfc_uid" ALIGN="LEFT">nfc_uid</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">UQ, NULL</FONT></TD></TR><TR><TD PORT="pin_salt" ALIGN="LEFT">pin_salt</TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="pin_hash" ALIGN="LEFT">pin_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="qr_credential" ALIGN="LEFT">qr_credential</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="entry_state" ALIGN="LEFT">entry_state</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="failed_pin_attempts" ALIGN="LEFT">failed_pin_attempts</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="pin_locked" ALIGN="LEFT">pin_locked</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="last_scan_timestamp" ALIGN="LEFT">last_scan_timestamp</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="photo_data" ALIGN="LEFT">photo_data</TD><TD ALIGN="LEFT">MEDIUMBLOB</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="is_temporary" ALIGN="LEFT">is_temporary</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="graduation_clearance" ALIGN="LEFT">graduation_clearance</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="graduation_reason" ALIGN="LEFT">graduation_reason</TD><TD ALIGN="LEFT">VARCHAR(1000)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="graduation_changed_by" ALIGN="LEFT">graduation_changed_by</TD><TD ALIGN="LEFT">VARCHAR(150)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="graduation_changed_at_utc" ALIGN="LEFT">graduation_changed_at_utc</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="graduation_revision" ALIGN="LEFT">graduation_revision</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
courses [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DBEEE3"><B>COURSES</B></TD></TR><TR><TD PORT="course_name" ALIGN="LEFT">course_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR></TABLE>>];
events [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DBEEE3"><B>EVENTS</B></TD></TR><TR><TD PORT="event_id" ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR><TR><TD PORT="event_name" ALIGN="LEFT">event_name</TD><TD ALIGN="LEFT">VARCHAR(150)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="event_date" ALIGN="LEFT">event_date</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="verification_mode" ALIGN="LEFT">verification_mode</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="is_restricted" ALIGN="LEFT">is_restricted</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR></TABLE>>];
event_approved_students [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DBEEE3"><B>EVENT_APPROVED_STUDENTS</B></TD></TR><TR><TD PORT="event_id" ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, LR, NN</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, LR, NN</FONT></TD></TR></TABLE>>];
staff [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DBEEE3"><B>STAFF</B></TD></TR><TR><TD PORT="nfc_uid" ALIGN="LEFT">nfc_uid</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR><TR><TD PORT="full_name" ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="role" ALIGN="LEFT">role</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="pin_hash" ALIGN="LEFT">pin_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="pin_salt" ALIGN="LEFT">pin_salt</TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR></TABLE>>];
app_settings [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DBEEE3"><B>APP_SETTINGS</B></TD></TR><TR><TD PORT="setting_key" ALIGN="LEFT">setting_key</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR><TR><TD PORT="setting_value" ALIGN="LEFT">setting_value</TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR></TABLE>>];  courses:e -> students:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#687078", style=dashed];
students:e -> event_approved_students:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#357052", style=dashed];
events:e -> event_approved_students:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#A74455", style=dashed]; }