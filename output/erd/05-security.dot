digraph ERD { graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.9, splines=polyline, concentrate=false, outputorder=edgesfirst]; node [shape=plain, fontname="Arial", fontsize=14]; edge [arrowsize=0.8, penwidth=1.2]; pin_security_versions [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#E9E2F3"><B>PIN_SECURITY_VERSIONS</B></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, LR, NN</FONT></TD></TR><TR><TD PORT="reset_token" ALIGN="LEFT">reset_token</TD><TD ALIGN="LEFT">CHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="revision" ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
pin_attempt_receipts [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#E9E2F3"><B>PIN_ATTEMPT_RECEIPTS</B></TD></TR><TR><TD PORT="attempt_id" ALIGN="LEFT">attempt_id</TD><TD ALIGN="LEFT">CHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="result_json" ALIGN="LEFT">result_json</TD><TD ALIGN="LEFT">LONGTEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
student_graduation_audit [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#E9E2F3"><B>STUDENT_GRADUATION_AUDIT</B></TD></TR><TR><TD PORT="audit_id" ALIGN="LEFT">audit_id</TD><TD ALIGN="LEFT">CHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="student_name" ALIGN="LEFT">student_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="action" ALIGN="LEFT">action</TD><TD ALIGN="LEFT">VARCHAR(30)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="old_value" ALIGN="LEFT">old_value</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="new_value" ALIGN="LEFT">new_value</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="reason" ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">VARCHAR(1000)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="actor" ALIGN="LEFT">actor</TD><TD ALIGN="LEFT">VARCHAR(150)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="changed_at_utc" ALIGN="LEFT">changed_at_utc</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
students [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#EDF0F2"><B>STUDENTS</B><BR/><FONT POINT-SIZE="11">REFERENCE ONLY</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR></TABLE>>]; { rank=same; students; } students:s -> pin_security_versions:n [dir=both, arrowtail="teeodot", arrowhead="teeodot", color="#357052", style=dashed];
students:s -> pin_attempt_receipts:n [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#357052", style=dashed];
students:s -> student_graduation_audit:n [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#357052", style=dashed]; }