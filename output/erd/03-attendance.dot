digraph ERD { graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.9, splines=polyline, concentrate=false, outputorder=edgesfirst]; node [shape=plain, fontname="Arial", fontsize=14]; edge [arrowsize=0.8, penwidth=1.2]; attendance_devices [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DDECF7"><B>ATTENDANCE_DEVICES</B></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT">device_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR><TR><TD PORT="device_name" ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="last_seen" ALIGN="LEFT">last_seen</TD><TD ALIGN="LEFT">DATETIME(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="reported_sequence" ALIGN="LEFT">reported_sequence</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="acknowledged_sequence" ALIGN="LEFT">acknowledged_sequence</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="ready" ALIGN="LEFT">ready</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="enabled" ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
attendance_receipts [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DDECF7"><B>ATTENDANCE_RECEIPTS</B></TD></TR><TR><TD PORT="transaction_id" ALIGN="LEFT">transaction_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT">device_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="device_sequence" ALIGN="LEFT">device_sequence</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="11">UQ (device_id, device_sequence)</FONT></TD></TR></TABLE>>];
attendance_decisions [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DDECF7"><B>ATTENDANCE_DECISIONS</B></TD></TR><TR><TD PORT="transaction_id" ALIGN="LEFT">transaction_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, LR, NN</FONT></TD></TR><TR><TD PORT="is_granted" ALIGN="LEFT">is_granted</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
attendance_current [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DDECF7"><B>ATTENDANCE_CURRENT</B></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, LR, NN</FONT></TD></TR><TR><TD PORT="state_json" ALIGN="LEFT">state_json</TD><TD ALIGN="LEFT">LONGTEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
attendance_visits [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#DDECF7"><B>ATTENDANCE_VISITS</B></TD></TR><TR><TD PORT="visit_id" ALIGN="LEFT">visit_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="entry_transaction_id" ALIGN="LEFT">entry_transaction_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="exit_transaction_id" ALIGN="LEFT">exit_transaction_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NULL</FONT></TD></TR><TR><TD PORT="time_in" ALIGN="LEFT">time_in</TD><TD ALIGN="LEFT">DATETIME(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="time_out" ALIGN="LEFT">time_out</TD><TD ALIGN="LEFT">DATETIME(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="confirmed" ALIGN="LEFT">confirmed</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
students [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#EDF0F2"><B>STUDENTS</B><BR/><FONT POINT-SIZE="11">REFERENCE ONLY</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR></TABLE>>];  students:e -> attendance_current:w [dir=both, arrowtail="teeodot", arrowhead="teeodot", color="#357052", style=dashed];
students:e -> attendance_visits:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#357052", style=dashed];
attendance_devices:e -> attendance_receipts:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#3B718E", style=dashed];
attendance_receipts:e -> attendance_decisions:w [dir=both, arrowtail="teeodot", arrowhead="teeodot", color="#687078", style=dashed];
attendance_receipts:e -> attendance_visits:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#687078", style=dashed];
attendance_receipts:e -> attendance_visits:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#687078", style=dashed]; }