digraph ERD { graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.9, splines=polyline, concentrate=false, outputorder=edgesfirst]; node [shape=plain, fontname="Arial", fontsize=14]; edge [arrowsize=0.8, penwidth=1.2]; event_attendance [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#F6DDE0"><B>EVENT_ATTENDANCE</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, AI, NN</FONT></TD></TR><TR><TD PORT="timestamp" ALIGN="LEFT">timestamp</TD><TD ALIGN="LEFT">DATETIME(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="event_id" ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NULL</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NULL</FONT></TD></TR><TR><TD PORT="verification_mode" ALIGN="LEFT">verification_mode</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="remarks" ALIGN="LEFT">remarks</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="synced_to_cloud" ALIGN="LEFT">synced_to_cloud</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NULL</FONT></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT">device_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="device_name" ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
event_roster_sync [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#F6DDE0"><B>EVENT_ROSTER_SYNC</B></TD></TR><TR><TD PORT="event_id" ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, LR, NN</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, LR, NN</FONT></TD></TR><TR><TD PORT="change_id" ALIGN="LEFT">change_id</TD><TD ALIGN="LEFT">CHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="approved" ALIGN="LEFT">approved</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="cloud_change_id" ALIGN="LEFT">cloud_change_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="cloud_update_time" ALIGN="LEFT">cloud_update_time</TD><TD ALIGN="LEFT">VARCHAR(40)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="pending" ALIGN="LEFT">pending</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="conflict" ALIGN="LEFT">conflict</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
event_completion_policies [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#F6DDE0"><B>EVENT_COMPLETION_POLICIES</B></TD></TR><TR><TD PORT="event_id" ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, LR, NN</FONT></TD></TR><TR><TD PORT="start_time" ALIGN="LEFT">start_time</TD><TD ALIGN="LEFT">DATETIME(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="end_time" ALIGN="LEFT">end_time</TD><TD ALIGN="LEFT">DATETIME(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="minimum_minutes" ALIGN="LEFT">minimum_minutes</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="late_minutes" ALIGN="LEFT">late_minutes</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="early_minutes" ALIGN="LEFT">early_minutes</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="revision" ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="coverage_since" ALIGN="LEFT">coverage_since</TD><TD ALIGN="LEFT">DATETIME(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
event_completion_scans [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#F6DDE0"><B>EVENT_COMPLETION_SCANS</B></TD></TR><TR><TD PORT="transaction_id" ALIGN="LEFT">transaction_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, LR, NN</FONT></TD></TR><TR><TD PORT="event_id" ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="event_log_id" ALIGN="LEFT">event_log_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="scan_time" ALIGN="LEFT">scan_time</TD><TD ALIGN="LEFT">DATETIME(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT">device_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="device_sequence" ALIGN="LEFT">device_sequence</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="recovered" ALIGN="LEFT">recovered</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="legacy" ALIGN="LEFT">legacy</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
event_completion_audit [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#F6DDE0"><B>EVENT_COMPLETION_AUDIT</B></TD></TR><TR><TD PORT="audit_id" ALIGN="LEFT">audit_id</TD><TD ALIGN="LEFT">BIGINT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, AI, NN</FONT></TD></TR><TR><TD PORT="event_id" ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="action" ALIGN="LEFT">action</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="previous_status" ALIGN="LEFT">previous_status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="new_status" ALIGN="LEFT">new_status</TD><TD ALIGN="LEFT">VARCHAR(30)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="reason" ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">VARCHAR(1000)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="actor" ALIGN="LEFT">actor</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="actor_role" ALIGN="LEFT">actor_role</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT">device_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">LR, NN</FONT></TD></TR><TR><TD PORT="device_name" ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="reviewed_at_utc" ALIGN="LEFT">reviewed_at_utc</TD><TD ALIGN="LEFT">DATETIME(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="evidence_stamp" ALIGN="LEFT">evidence_stamp</TD><TD ALIGN="LEFT">VARCHAR(64)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR><TR><TD PORT="evidence_json" ALIGN="LEFT">evidence_json</TD><TD ALIGN="LEFT">LONGTEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">NN</FONT></TD></TR></TABLE>>];
students [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#EDF0F2"><B>STUDENTS</B><BR/><FONT POINT-SIZE="11">REFERENCE ONLY</FONT></TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR></TABLE>>];
events [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#EDF0F2"><B>EVENTS</B><BR/><FONT POINT-SIZE="11">REFERENCE ONLY</FONT></TD></TR><TR><TD PORT="event_id" ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR></TABLE>>];
attendance_devices [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#EDF0F2"><B>ATTENDANCE_DEVICES</B><BR/><FONT POINT-SIZE="11">REFERENCE ONLY</FONT></TD></TR><TR><TD PORT="device_id" ALIGN="LEFT">device_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR></TABLE>>];
attendance_receipts [label=<<TABLE BORDER="1" COLOR="#89949E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#EDF0F2"><B>ATTENDANCE_RECEIPTS</B><BR/><FONT POINT-SIZE="11">REFERENCE ONLY</FONT></TD></TR><TR><TD PORT="transaction_id" ALIGN="LEFT">transaction_id</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#44515E">PK, NN</FONT></TD></TR></TABLE>>]; { rank=same; students; events; attendance_devices; attendance_receipts; } students:s -> event_attendance:n [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#357052", style=dashed];
