<Window
    x:Class="NFC_System.QrScannerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="QR Credential Scanner">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="32" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock Text="Scan QR Credential" Style="{StaticResource PageTitleStyle}" FontSize="28"/>
            <TextBlock Text="Align the student's QR code within the highlighted frame below. The system will automatically capture a valid payload." Style="{StaticResource BodyTextStyle}" Opacity="0.8"/>
        </StackPanel>

        <!-- Camera Viewport & Bounding Box -->
        <Border Grid.Row="1" CornerRadius="{StaticResource CardCornerRadius}" Background="Black" BorderBrush="#15FFFFFF" BorderThickness="1">
            <Grid>
                <!-- Live Camera Feed Container -->
                <MediaPlayerElement x:Name="CameraPreview" AutoPlay="True" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Darkened Overlay Grid (Dims everything outside the bounding box) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="280"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dimmed Outer Regions -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#A6000000"/>
                    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#A6000000"/>
                    <Border Grid.Row="1" Grid.Column="0" Background="#A6000000"/>
                    <Border Grid.Row="1" Grid.Column="2" Background="#A6000000"/>

                    <!-- Center Bounding Box Target -->
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="3" CornerRadius="16" Background="Transparent">
                        <!-- Simulated Scanner Line -->
                        <Border Height="2" Background="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" Opacity="0.6"/>
                    </Border>
                </Grid>

                <!-- Status Overlay -->
                <Border x:Name="ScanStatusBadge" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,8" CornerRadius="999" Background="#CC1E1E1E" BorderBrush="#30FFFFFF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="True" Width="16" Height="16" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock x:Name="ScanStatusText" Text="Searching for QR Code..." Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Footer Controls -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Camera Selection -->
            <ComboBox x:Name="CameraDeviceComboBox" Grid.Column="0" Header="Active Camera" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,16,0">
                <ComboBoxItem Content="Integrated Webcam"/>
                <ComboBoxItem Content="USB HD Camera (External)"/>
            </ComboBox>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Height="40" Width="100" CornerRadius="{StaticResource ButtonCornerRadius}" Background="Transparent" BorderBrush="#30FFFFFF"/>
                <Button x:Name="ManualCaptureButton" Content="Capture Payload" Click="ManualCaptureButton_Click" Height="40" Width="140" CornerRadius="{StaticResource ButtonCornerRadius}" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>