<UserControl
    x:Class="NFC_System.ServerConnectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark" Foreground="#FFFFFF">
    <UserControl.Resources>
        <Style x:Key="ServerComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#22232A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#52525B"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="12">
        <ComboBox x:Name="RoleBox" Style="{StaticResource ServerComboBoxStyle}" Header="This device" HorizontalAlignment="Stretch" SelectionChanged="RoleBox_SelectionChanged">
            <ComboBoxItem Content="Main Server" Tag="MainServer"/>
            <ComboBoxItem Content="Connect to Main Server" Tag="Client"/>
            <ComboBoxItem Content="Administration Device (Local)" Tag="Administration"/>
        </ComboBox>
        <TextBox x:Name="HostBox" Header="MySQL Server IP Address" Background="#22232A" Foreground="#FFFFFF" BorderBrush="#52525B" PlaceholderText="192.168.1.7" TextChanged="HostBox_TextChanged"/>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DetectButton" Background="#30313A" Foreground="#FFFFFF" BorderBrush="#52525B" Click="DetectButton_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Find main servers on the local network">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="16"/>
                    <TextBlock Text="Automatically Detect Server" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
            <Button x:Name="CancelDetectionButton" Grid.Column="1" Background="#30313A" Foreground="#FFFFFF" BorderBrush="#52525B" Click="CancelDetectionButton_Click" Visibility="Collapsed" ToolTipService.ToolTip="Cancel server detection" AutomationProperties.Name="Cancel server detection">
                <FontIcon Glyph="&#xE711;" FontSize="16"/>
            </Button>
        </Grid>
        <ComboBox x:Name="ServersBox" Style="{StaticResource ServerComboBoxStyle}" Header="Detected main servers" DisplayMemberPath="DisplayLabel" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="ServersBox_SelectionChanged"/>
        <ProgressRing x:Name="SearchingRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left"/>
        <TextBlock x:Name="ConnectionNote" TextWrapping="Wrap" Foreground="#A3A3A8" FontSize="12"/>
    </StackPanel>
</UserControl>
