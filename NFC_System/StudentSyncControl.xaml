<UserControl
    x:Class="NFC_System.StudentSyncControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark" Foreground="White">
    <StackPanel Spacing="10">
        <TextBlock Text="Student Profile Sync" FontSize="16" FontWeight="SemiBold"/>
        <TextBox x:Name="ServerIdBox" Header="Main Server ID" MaxLength="32" TextWrapping="Wrap"/>
        <TextBox x:Name="EmailBox" Header="Approved cloud email" MaxLength="150"/>
        <PasswordBox x:Name="PasswordBox" Header="Cloud password"/>
        <Button x:Name="ConnectButton" Click="Connect_Click" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE753;"/><TextBlock Text="Connect Account"/></StackPanel>
        </Button>
        <Button x:Name="DisconnectButton" Click="Disconnect_Click" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8AC;"/><TextBlock Text="Disconnect Account"/></StackPanel>
        </Button>
        <Button x:Name="CheckButton" Click="Check_Click" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="Check Now"/></StackPanel>
        </Button>
        <StackPanel x:Name="AdministrationActions" Spacing="10">
            <Button x:Name="UploadButton" Click="Upload_Click" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE898;"/><TextBlock Text="Upload Student Changes" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <CheckBox x:Name="ReplaceLocalBox" Content="Replace local changes when downloading"/>
            <Button x:Name="DownloadButton" Click="Download_Click" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;"/><TextBlock Text="Download Student Profiles" TextWrapping="Wrap"/></StackPanel>
            </Button>
        </StackPanel>
        <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left"/>
        <TextBlock x:Name="SyncStatus" FontSize="12" TextWrapping="Wrap" Foreground="#C9CDD4"/>
    </StackPanel>
</UserControl>
