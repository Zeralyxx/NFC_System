<Window
    x:Class="NFC_System.StudentManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Student Search &amp; Management">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="48" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Content="Back to Dashboard" Click="BackButton_Click" Padding="16,10" CornerRadius="{StaticResource ButtonCornerRadius}" VerticalAlignment="Top" Margin="0,4,0,0"/>

            <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="4">
                <TextBlock Text="Student Directory &amp; Security State" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                <TextBlock Text="Search records, manage enrollment status, and review PIN lockout security flags." Style="{StaticResource BodyTextStyle}" FontSize="16"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Search & Data Grid -->
            <Border Grid.Column="0" Padding="24" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search and Filter Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,24" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- FIX: Added Header to align perfectly with the comboboxes -->
                        <TextBox x:Name="SearchBox" Grid.Column="0" Header="Search Directory" PlaceholderText="Search by ID, Name, or UID..." TextChanged="SearchBox_TextChanged" VerticalAlignment="Stretch"/>

                        <ComboBox x:Name="CourseFilterComboBox" Grid.Column="1" Header="Course" Width="180" SelectionChanged="Filter_SelectionChanged" VerticalAlignment="Stretch"/>

                        <ComboBox x:Name="StatusFilterComboBox" Grid.Column="2" Header="Filter Status" SelectedIndex="0" Width="160" SelectionChanged="Filter_SelectionChanged" VerticalAlignment="Stretch">
                            <ComboBoxItem Content="All Students"/>
                            <ComboBoxItem Content="Active Only"/>
                            <ComboBoxItem Content="Locked Out"/>
                            <ComboBoxItem Content="Inactive"/>
                        </ComboBox>
                    </Grid>

                    <!-- Pseudo-DataGrid Header -->
                    <Border Grid.Row="1" Background="#0AFFFFFF" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Student ID" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="Full Name" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="Course" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Native DataGrid (ListView) -->
                    <ListView x:Name="StudentListView" Grid.Row="2" SelectionChanged="StudentListView_SelectionChanged" Background="Transparent" CornerRadius="8">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding StudentId}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FullName}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Course}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Paging Controls -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24" Margin="0,16,0,0">
                        <Button x:Name="PrevBtn" Content="&#xE76B;" FontFamily="Segoe Fluent Icons" Click="PageChange_Click" IsEnabled="False" Background="Transparent" BorderThickness="1" BorderBrush="#20FFFFFF"/>
                        <TextBlock x:Name="PageInfoText" Text="Page 1 of 1" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        <Button x:Name="NextBtn" Content="&#xE76C;" FontFamily="Segoe Fluent Icons" Click="PageChange_Click" IsEnabled="False" Background="Transparent" BorderThickness="1" BorderBrush="#20FFFFFF"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Column: Edit Panel -->
            <!-- Right Column: Edit Panel -->
            <Border Grid.Column="1" Padding="32" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="24">

                        <StackPanel Spacing="8">
                            <TextBlock Text="Configuration Panel" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Manage individual security access or perform global batch status updates." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- MOVED UP: Batch Operations Trigger -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Advanced Global Operations" Style="{StaticResource DataValueStyle}" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Button x:Name="OpenBatchDialogButton" Content="Batch Update Status (Graduation / Expulsion)" Click="OpenBatchDialogButton_Click" HorizontalAlignment="Stretch" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" Background="#1AFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,8"/>

                        <!-- Edit Controls -->
                        <StackPanel Spacing="16">
                            <TextBlock Text="Individual Security &amp; Enrollment" Style="{StaticResource DataValueStyle}"/>

                            <ComboBox x:Name="EditStatusComboBox" Header="Enrollment Status" HorizontalAlignment="Stretch" IsEnabled="False">
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Inactive"/>
                                <ComboBoxItem Content="Graduated"/>
                                <ComboBoxItem Content="Expelled"/>
                            </ComboBox>

                            <Border Padding="16" CornerRadius="12" Background="#1AFFFFFF" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="2FA Lockout State" Style="{StaticResource DataValueStyle}"/>
                                        <TextBlock x:Name="LockoutStatusText" Text="Select a student" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="UnlockAccountButton" Grid.Column="1" Content="Unlock Account" Click="UnlockAccountButton_Click" IsEnabled="False" CornerRadius="{StaticResource ButtonCornerRadius}" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Button x:Name="SaveChangesButton" Content="Save Security Changes" Click="SaveChangesButton_Click" IsEnabled="False" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="0,8,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- POPUP: BATCH OPERATIONS                                   -->
        <!-- ========================================================= -->
        <ContentDialog x:Name="BatchUpdateDialog" Title="Batch Status Update" CloseButtonText="Cancel" CornerRadius="8">
            <StackPanel Spacing="16" Width="400" Margin="0,16,0,0">
                <TextBlock Text="Warning: This will permanently change the enrollment status of multiple students in the selected bracket. This action will be logged." Foreground="#F87171" TextWrapping="Wrap" FontSize="13"/>

                <ComboBox x:Name="BatchCourseComboBox" Header="Target Course" HorizontalAlignment="Stretch"/>

                <ComboBox x:Name="BatchYearComboBox" Header="Target Year Level" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="All Years"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5+"/>
                </ComboBox>

                <ComboBox x:Name="BatchNewStatusComboBox" Header="New Status to Apply" HorizontalAlignment="Stretch" SelectedIndex="2">
                    <ComboBoxItem Content="Active"/>
                    <ComboBoxItem Content="Inactive"/>
                    <ComboBoxItem Content="Graduated"/>
                    <ComboBoxItem Content="Expelled"/>
                </ComboBox>

                <Button x:Name="ConfirmBatchButton" Content="Apply Batch Update" Click="ConfirmBatchButton_Click" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Height="44" Margin="0,16,0,0"/>
                <TextBlock x:Name="BatchDialogStatusText" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" FontWeight="SemiBold" Visibility="Collapsed"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>