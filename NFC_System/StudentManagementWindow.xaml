<Window
    x:Class="NFC_System.StudentManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Student Search &amp; Management">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="48" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Content="Back to Dashboard" Click="BackButton_Click" Padding="16,10" CornerRadius="{StaticResource ButtonCornerRadius}" VerticalAlignment="Top" Margin="0,4,0,0"/>

            <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="4">
                <TextBlock Text="Student Directory &amp; Security State" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                <TextBlock Text="Search records, update IDs, and manage enrollment status." Style="{StaticResource BodyTextStyle}" FontSize="16"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Search & Data Grid -->
            <Border Grid.Column="0" Padding="24" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header & Enlarge Trigger -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Student Roster" Style="{StaticResource CardTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                        <Button x:Name="OpenPopupDirectoryButton" Grid.Column="1" Content="⛶ Full Screen Explorer" Click="OpenPopupDirectoryButton_Click" CornerRadius="{StaticResource ButtonCornerRadius}" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Height="36" Padding="16,0"/>
                    </Grid>

                    <!-- Search and Filter Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,24" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" Grid.Column="0" Header="Search Directory" PlaceholderText="Search by ID, Name, or UID..." TextChanged="SearchBox_TextChanged" VerticalAlignment="Stretch"/>
                        <ComboBox x:Name="CourseFilterComboBox" Grid.Column="1" Header="Course" Width="180" SelectionChanged="Filter_SelectionChanged" VerticalAlignment="Stretch"/>
                        <ComboBox x:Name="StatusFilterComboBox" Grid.Column="2" Header="Filter Status" SelectedIndex="0" Width="160" SelectionChanged="Filter_SelectionChanged" VerticalAlignment="Stretch">
                            <ComboBoxItem Content="All Students"/>
                            <ComboBoxItem Content="Active Only"/>
                            <ComboBoxItem Content="Locked Out"/>
                            <ComboBoxItem Content="Inactive"/>
                        </ComboBox>
                    </Grid>

                    <!-- Pseudo-DataGrid Header -->
                    <Border Grid.Row="2" Background="#0AFFFFFF" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="2.0*"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.0*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0" Click="SortHeader_Click" Tag="StudentId" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Student ID" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                    <FontIcon x:Name="SortIcon_StudentId" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" Click="SortHeader_Click" Tag="FullName" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Full Name" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                    <FontIcon x:Name="SortIcon_FullName" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" Click="SortHeader_Click" Tag="Course" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Course" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                    <FontIcon x:Name="SortIcon_Course" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0" Click="SortHeader_Click" Tag="Year" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Year" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                    <FontIcon x:Name="SortIcon_Year" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0" Click="SortHeader_Click" Tag="Section" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Section" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                    <FontIcon x:Name="SortIcon_Section" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Padding="0" Click="SortHeader_Click" Tag="Status" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Status" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                    <FontIcon x:Name="SortIcon_Status" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Native DataGrid (ListView) -->
                    <ListView x:Name="StudentListView" Grid.Row="3" SelectionChanged="StudentListView_SelectionChanged" Background="Transparent" CornerRadius="8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="16,0,16,0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="2.0*"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="1.0*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding StudentId}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FullName}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Course}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding YearLevel}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="4" Text="{Binding SectionName}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Status}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Paging Controls -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24" Margin="0,16,0,0">
                        <Button x:Name="PrevBtn" Content="&#xE76B;" FontFamily="Segoe Fluent Icons" Click="PageChange_Click" IsEnabled="False" Background="Transparent" BorderThickness="1" BorderBrush="#20FFFFFF"/>
                        <TextBlock x:Name="PageInfoText" Text="Page 1 of 1" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        <Button x:Name="NextBtn" Content="&#xE76C;" FontFamily="Segoe Fluent Icons" Click="PageChange_Click" IsEnabled="False" Background="Transparent" BorderThickness="1" BorderBrush="#20FFFFFF"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Column: Edit Panel -->
            <Border Grid.Column="1" Padding="32" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="24">

                        <StackPanel Spacing="8">
                            <TextBlock Text="Configuration Panel" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Manage individual security access or perform global batch status updates." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Batch Operations Trigger -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Advanced Global Operations" Style="{StaticResource DataValueStyle}" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Button x:Name="OpenBatchDialogButton" Content="Batch Update Status (Graduation / Expulsion)" Click="OpenBatchDialogButton_Click" HorizontalAlignment="Stretch" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" Background="#1AFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,8"/>

                        <!-- Edit Controls -->
                        <StackPanel Spacing="16">
                            <TextBlock Text="Individual Profile Management" Style="{StaticResource DataValueStyle}"/>

                            <TextBox x:Name="EditStudentIdBox" Header="Student ID (Editable)" PlaceholderText="Select a student to edit..." IsEnabled="False"/>

                            <ComboBox x:Name="EditStatusComboBox" Header="Enrollment Status" HorizontalAlignment="Stretch" IsEnabled="False">
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Inactive"/>
                                <ComboBoxItem Content="Graduated"/>
                                <ComboBoxItem Content="Expelled"/>
                            </ComboBox>
                        </StackPanel>

                        <Grid ColumnSpacing="12" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DeleteStudentButton" Grid.Column="0" Content="Delete Profile" Click="DeleteStudentButton_Click" IsEnabled="False" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch" Background="#40FF0000" Foreground="#FF8888" BorderBrush="#80FF0000" BorderThickness="1"/>
                            <Button x:Name="SaveChangesButton" Grid.Column="1" Content="Save Changes" Click="SaveChangesButton_Click" IsEnabled="False" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- POPUP: BATCH OPERATIONS                                   -->
        <!-- ========================================================= -->
        <ContentDialog x:Name="BatchUpdateDialog" Title="Batch Status Update" CloseButtonText="Cancel" CornerRadius="8">
            <StackPanel Spacing="16" Width="400" Margin="0,16,0,0">
                <TextBlock Text="Warning: This will permanently change the enrollment status of multiple students. Requires Admin NFC tap." Foreground="#F87171" TextWrapping="Wrap" FontSize="13"/>

                <ComboBox x:Name="BatchCourseComboBox" Header="Target Course" HorizontalAlignment="Stretch"/>

                <ComboBox x:Name="BatchYearComboBox" Header="Target Year Level" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="All Years"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5+"/>
                </ComboBox>

                <ComboBox x:Name="BatchNewStatusComboBox" Header="New Status to Apply" HorizontalAlignment="Stretch" SelectedIndex="2">
                    <ComboBoxItem Content="Active"/>
                    <ComboBoxItem Content="Inactive"/>
                    <ComboBoxItem Content="Graduated"/>
                    <ComboBoxItem Content="Expelled"/>
                </ComboBox>

                <Button x:Name="ConfirmBatchButton" Content="Apply Batch Update" Click="ConfirmBatchButton_Click" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Height="44" Margin="0,16,0,0"/>
            </StackPanel>
        </ContentDialog>

        <!-- ========================================================= -->
        <!-- THE FIX: ADMINISTRATOR AUTHORIZATION INTERCEPT POPUP      -->
        <!-- ========================================================= -->
        <ContentDialog x:Name="AdminAuthDialog"
                       Title="Administrator Authorization Required"
                       CloseButtonText="Cancel"
                       CornerRadius="8">
            <StackPanel Spacing="16" Width="350">
                <TextBlock Text="This action requires Administrator privileges. Please tap your authorized NFC card to proceed." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Border Background="#1A3B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing IsActive="True" Width="24" Height="24"/>
                        <TextBlock Text="Awaiting Admin NFC tap..." FontWeight="SemiBold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="AuthStatusText" Foreground="#F87171" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </ContentDialog>

        <!-- ========================================================= -->
        <!-- EXPANDABLE POPUP DIALOG FOR DEEP INSPECTION               -->
        <!-- ========================================================= -->
        <ContentDialog x:Name="MasterDirectoryDialog"
                       CloseButtonText="Close"
                       DefaultButton="Close"
                       CornerRadius="8">

            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
            </ContentDialog.Resources>

            <Grid x:Name="DialogDirectoryContainer" Width="900" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Master Student Directory" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="PopupExpandToggle" Grid.Column="1" Content="⛶ Expand View" Click="PopupExpandToggle_Click" Background="Transparent" BorderBrush="#30FFFFFF" BorderThickness="1" FontWeight="SemiBold"/>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PopupSearchBox" Grid.Column="0" PlaceholderText="Search ID, Name, or UID..." TextChanged="PopupFilter_Changed"/>
                    <ComboBox x:Name="PopupCourseFilter" Grid.Column="1" Header="" HorizontalAlignment="Stretch" SelectionChanged="PopupFilter_Changed"/>
                    <ComboBox x:Name="PopupStatusFilter" Grid.Column="2" Header="" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="PopupFilter_Changed">
                        <ComboBoxItem Content="All Students"/>
                        <ComboBoxItem Content="Active Only"/>
                        <ComboBoxItem Content="Locked Out"/>
                        <ComboBoxItem Content="Inactive"/>
                    </ComboBox>
                    <Button Grid.Column="3" Content="Clear" Click="PopupClear_Click" Background="Transparent" BorderThickness="1" BorderBrush="#30FFFFFF"/>
                </Grid>

                <Border Grid.Row="2" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Background="#05FFFFFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0AFFFFFF" CornerRadius="8,8,0,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="2.0*"/>
                                    <ColumnDefinition Width="2.8*"/>
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0" Click="PopupSortHeader_Click" Tag="StudentId" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Student ID" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                        <FontIcon x:Name="PopupSortIcon_StudentId" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" Click="PopupSortHeader_Click" Tag="FullName" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Full Name" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                        <FontIcon x:Name="PopupSortIcon_FullName" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" Click="PopupSortHeader_Click" Tag="Course" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Course" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                        <FontIcon x:Name="PopupSortIcon_Course" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0" Click="PopupSortHeader_Click" Tag="Year" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Year" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                        <FontIcon x:Name="PopupSortIcon_Year" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0" Click="PopupSortHeader_Click" Tag="Section" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Section" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                        <FontIcon x:Name="PopupSortIcon_Section" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Padding="0" Click="PopupSortHeader_Click" Tag="Status" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Status" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                        <FontIcon x:Name="PopupSortIcon_Status" FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="#80FFFFFF"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <ListView Grid.Row="1" x:Name="PopupStudentListView" Height="500" Background="Transparent" Padding="0,8" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="16,0,16,0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="16,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="2.0*"/>
                                            <ColumnDefinition Width="2.8*"/>
                                            <ColumnDefinition Width="0.6*"/>
                                            <ColumnDefinition Width="0.7*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StudentId}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FullName}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Course}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding YearLevel}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding SectionName}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Status}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </ContentDialog>
        <!-- ========================================================= -->
        <!-- POPUP: FULL STUDENT PROFILE EDIT (Double-Click Trigger)   -->
        <!-- ========================================================= -->
        <ContentDialog x:Name="EditStudentDialog"
               Title="Edit Student Profile"
               CloseButtonText="Cancel"
               CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="520">
                <StackPanel Spacing="16" Width="480" Margin="0,8,0,0">

                    <TextBlock x:Name="EditDialogStatusText" Foreground="#F87171" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <TextBox x:Name="EditDialogStudentIdBox" Header="Student ID" TextChanging="NumberOnly_TextChanging"/>
                    <TextBox x:Name="EditDialogFullNameBox" Header="Full Name"/>
                    <TextBox x:Name="EditDialogEmailBox" Header="Email Address" PlaceholderText="michael.sintay@tcu.edu.ph"/>
                    <ComboBox x:Name="EditDialogCourseComboBox" Header="Course" HorizontalAlignment="Stretch"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="EditDialogYearLevelBox" Header="Year Level" TextChanging="NumberOnly_TextChanging"/>
                        <TextBox Grid.Column="1" x:Name="EditDialogSectionBox" Header="Section"/>
                    </Grid>

                    <ComboBox x:Name="EditDialogStatusComboBox" Header="Enrollment Status" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Inactive"/>
                        <ComboBoxItem Content="Graduated"/>
                        <ComboBoxItem Content="Expelled"/>
                    </ComboBox>

                    <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,4"/>

                    <StackPanel Spacing="8">
                        <TextBox x:Name="EditDialogNfcUidBox" Header="NFC UID"/>
                        <Button x:Name="ChangeNfcButton" Content="Card Lost? Tap New NFC Card" Click="ChangeNfcButton_Click"
                            HorizontalAlignment="Stretch" Height="40" CornerRadius="{StaticResource ButtonCornerRadius}"
                            Background="#1AFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                        <TextBlock x:Name="NfcScanStatusText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBox x:Name="NfcReplacementReasonBox" Header="Reason for card replacement"
                                PlaceholderText="e.g. reported lost, found in library, card damaged..."
                                Visibility="Collapsed"/>
                    </StackPanel>
                    <PasswordBox x:Name="EditDialogNewPinBox" Header="Reset PIN (leave blank to keep current)" MaxLength="4" PlaceholderText="****"/>


                    <Button x:Name="EditDialogSaveButton" Content="Save Changes" Click="EditDialogSaveButton_Click"
                        IsEnabled="False"
                        HorizontalAlignment="Stretch" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}"
                        Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                        Margin="0,8,0,0"/>

                    <TextBlock Text="Saving requires an Administrator NFC tap to confirm." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>