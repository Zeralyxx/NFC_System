<Window
    x:Class="NFC_System.SecurityDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SecurityDashboardWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Back" Padding="16,10" Click="BackButton_Click" CornerRadius="12"/>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="4">
                <TextBlock Text="Security Administration" FontSize="38" FontWeight="Bold"/>
                <TextBlock Text="Configure risk modes, restricted events, PIN recovery, alerts, and audit logs" FontSize="16" Opacity="0.72"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh Logs" Padding="16,10" CornerRadius="12"/>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">
                    <Border Padding="24" CornerRadius="24" Background="#1F2A37" BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Verification Mode Control" FontSize="26" FontWeight="SemiBold"/>
                            <ComboBox x:Name="DefaultModeComboBox" Header="Default Risk Mode" SelectedIndex="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Fast (NFC Only)"/>
                                <ComboBoxItem Content="Standard (NFC + PIN)"/>
                                <ComboBoxItem Content="High-Security (NFC + PIN + QR)"/>
                            </ComboBox>
                            <Button x:Name="SaveDefaultModeButton" Content="Save Default Mode" Height="44" CornerRadius="12" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="24" CornerRadius="24" Background="#23283A" BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="PIN Lockout Recovery" FontSize="26" FontWeight="SemiBold"/>
                            <TextBox x:Name="ResetStudentIdTextBox" Header="Student ID" PlaceholderText="e.g. 26-00001"/>
                            <PasswordBox x:Name="NewPinPasswordBox" Header="New 4-Digit PIN" MaxLength="4" PlaceholderText="****"/>
                            <Button x:Name="ResetPinButton" Content="Reset PIN and Unlock" Height="44" CornerRadius="12" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="24" CornerRadius="24" Background="#2B2352" BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Restricted Event Setup" FontSize="26" FontWeight="SemiBold"/>
                            <TextBox x:Name="EventIdTextBox" Header="Event ID" PlaceholderText="e.g. EVT-001"/>
                            <TextBox x:Name="EventNameTextBox" Header="Event Name" PlaceholderText="Foundation Day Assembly"/>
                            <ComboBox x:Name="EventModeComboBox" Header="Event Verification Mode" SelectedIndex="2" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Fast (NFC Only)"/>
                                <ComboBoxItem Content="Standard (NFC + PIN)"/>
                                <ComboBoxItem Content="High-Security (NFC + PIN + QR)"/>
                            </ComboBox>
                            <CheckBox x:Name="RestrictedEventCheckBox" Content="Restricted event: only approved attendees are allowed" IsChecked="True"/>
                            <Button x:Name="SaveEventButton" Content="Save Event" Height="44" CornerRadius="12" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="24" CornerRadius="24" Background="#3A2323" BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Approved Attendee List" FontSize="26" FontWeight="SemiBold"/>
                            <TextBox x:Name="AttendeeEventIdTextBox" Header="Event ID" PlaceholderText="e.g. EVT-001"/>
                            <TextBox x:Name="AttendeeStudentIdTextBox" Header="Student ID" PlaceholderText="e.g. 26-00001"/>
                            <Button x:Name="AddAttendeeButton" Content="Approve Student for Event" Height="44" CornerRadius="12" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusTextBlock" Text="Ready" Opacity="0.8" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="24" CornerRadius="24" Background="#1A1F2E" BorderBrush="#30FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Security Alerts" FontSize="28" FontWeight="SemiBold"/>
                            <Border Grid.Column="1" Padding="10,4" CornerRadius="999" Background="#22F75555">
                                <TextBlock Text="Flagged" Foreground="#F75555" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <ListView x:Name="AlertsListView"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Padding="24" CornerRadius="24" Background="#1F2A37" BorderBrush="#30FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Verification Audit Trail" FontSize="28" FontWeight="SemiBold"/>
                        <ListView x:Name="AuditLogsListView"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
