<Window
    x:Class="NFC_System.SecurityDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Security Administration">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="48" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Back to Dashboard" Padding="16,10" Click="BackButton_Click" CornerRadius="{StaticResource ButtonCornerRadius}" VerticalAlignment="Top" Margin="0,4,0,0"/>

            <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="4">
                <TextBlock Text="Security Administration" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                <TextBlock Text="Configure risk modes, restricted events, PIN recovery, alerts, and audit logs" Style="{StaticResource BodyTextStyle}" FontSize="16"/>
            </StackPanel>

            <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh Logs" Click="RefreshButton_Click" Padding="16,10" Height="40" CornerRadius="{StaticResource ButtonCornerRadius}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/>
                <ColumnDefinition Width="5.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Administration Modules -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                <StackPanel Spacing="24">

                    <!-- 1. Verification Mode Control -->
                    <Border Padding="24" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Verification Mode Control" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                            <ComboBox x:Name="DefaultModeComboBox" Header="Default Risk Mode" SelectedIndex="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Fast (NFC Only)"/>
                                <ComboBoxItem Content="Standard (NFC + PIN)"/>
                                <ComboBoxItem Content="High-Security (NFC + PIN + QR)"/>
                            </ComboBox>
                            <Button x:Name="SaveDefaultModeButton" Content="Save Default Mode" Height="40" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. PIN Lockout Recovery -->
                    <Border Padding="24" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="PIN Lockout Recovery" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ResetStudentIdTextBox" Grid.Column="0" Header="Student ID" PlaceholderText="e.g. 26-00001"/>
                                <PasswordBox x:Name="NewPinPasswordBox" Grid.Column="1" Header="New 4-Digit PIN" MaxLength="4" PlaceholderText="****"/>
                            </Grid>
                            <Button x:Name="ResetPinButton" Content="Reset PIN and Unlock" Height="40" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Restricted Event Setup -->
                    <Border Padding="24" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Restricted Event Setup" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EventIdTextBox" Grid.Column="0" Header="Event ID" PlaceholderText="e.g. EVT-001"/>
                                <TextBox x:Name="EventNameTextBox" Grid.Column="1" Header="Event Name" PlaceholderText="Foundation Day Assembly"/>
                            </Grid>
                            <ComboBox x:Name="EventModeComboBox" Header="Event Verification Mode" SelectedIndex="2" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Fast (NFC Only)"/>
                                <ComboBoxItem Content="Standard (NFC + PIN)"/>
                                <ComboBoxItem Content="High-Security (NFC + PIN + QR)"/>
                            </ComboBox>
                            <CheckBox x:Name="RestrictedEventCheckBox" Content="Restricted event: only approved attendees are allowed" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button x:Name="SaveEventButton" Content="Save Event" Height="40" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Approved Attendee List -->
                    <Border Padding="24" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Approved Attendee List" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AttendeeEventIdTextBox" Grid.Column="0" Header="Event ID" PlaceholderText="e.g. EVT-001"/>
                                <TextBox x:Name="AttendeeStudentIdTextBox" Grid.Column="1" Header="Student ID" PlaceholderText="e.g. 26-00001"/>
                            </Grid>
                            <Button x:Name="AddAttendeeButton" Content="Approve Student for Event" Height="40" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusTextBlock" Text="Ready" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: Logs & Alerts -->
            <Grid Grid.Column="1" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- Security Alerts -->
                <Border Grid.Row="0" Padding="32" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Security Alerts" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                            <Border Grid.Column="1" Padding="12,4" CornerRadius="12" Background="#1AF87171" BorderBrush="#30F87171" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="Flagged" Style="{StaticResource BodyTextStyle}" FontSize="12" FontWeight="SemiBold" Foreground="#F87171"/>
                            </Border>
                        </Grid>

                        <ListView Grid.Row="1" x:Name="AlertsListView" Background="Transparent" Padding="0,0,16,0"/>
                    </Grid>
                </Border>

                <!-- Verification Audit Trail -->
                <Border Grid.Row="1" Padding="32" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Verification Audit Trail" Style="{StaticResource CardTitleStyle}"/>
                        <ListView Grid.Row="1" x:Name="AuditLogsListView" Background="Transparent" Padding="0,0,16,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>