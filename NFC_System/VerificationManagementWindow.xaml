<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NFC_System.VerificationManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Verification Management">

    <Grid Background="#0F0F17">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Background="#16161F" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="← Back"
                    Click="BackButton_Click"
                    Background="#252532"
                    Foreground="#9094A8"
                    Padding="10,5"
                    CornerRadius="5"
                    FontSize="12"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="VERIFICATION MANAGEMENT"
                       FontSize="13" FontWeight="Bold"
                       Foreground="#CDD6F4"
                       CharacterSpacing="80"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <!-- ── Main content: 3 columns ── -->
        <Grid Grid.Row="1" Padding="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT PANEL ══ -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- New session form -->
                <Border Grid.Row="0"
                        Background="#16161F"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,10"
                        BorderBrush="#2A2A3D"
                        BorderThickness="1">
                    <StackPanel Spacing="0">
                        <TextBlock Text="NEW SESSION / DAY"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#45475A"
                                   CharacterSpacing="80"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Label" Foreground="#6C7086" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="SessionLabelTextBox"
                                 PlaceholderText="e.g. Monday — Enrollment Day"
                                 Background="#252532"
                                 Foreground="White"
                                 BorderBrush="#3D3D52"
                                 CornerRadius="6"
                                 FontSize="12"
                                 Padding="8,6"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Location" Foreground="#6C7086" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="SessionLocationTextBox"
                                 PlaceholderText="Main Gate"
                                 Background="#252532"
                                 Foreground="White"
                                 BorderBrush="#3D3D52"
                                 CornerRadius="6"
                                 FontSize="12"
                                 Padding="8,6"
                                 Margin="0,0,0,14"/>

                        <Button Content="＋  Create Session"
                                Click="CreateSessionButton_Click"
                                Background="#89B4FA"
                                Foreground="#0F0F17"
                                FontWeight="Bold"
                                FontSize="12"
                                HorizontalAlignment="Stretch"
                                Padding="10,8"
                                CornerRadius="7"/>
                    </StackPanel>
                </Border>

                <!-- Controls -->
                <Border Grid.Row="1"
                        Background="#16161F"
                        CornerRadius="10"
                        Padding="14"
                        BorderBrush="#2A2A3D"
                        BorderThickness="1">
                    <StackPanel Spacing="0">
                        <TextBlock Text="CONTROLS"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#45475A"
                                   CharacterSpacing="80"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Select a session from the list first"
                                   Foreground="#3D3D52"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <Button Content="▶  Start Session"
                                Click="StartSessionButton_Click"
                                Background="#A6E3A1"
                                Foreground="#0F0F17"
                                FontWeight="Bold"
                                FontSize="12"
                                HorizontalAlignment="Stretch"
                                Padding="10,8"
                                CornerRadius="7"
                                Margin="0,0,0,6"/>

                        <Button Content="■  End Session"
                                Click="EndSessionButton_Click"
                                Background="#F38BA8"
                                Foreground="#0F0F17"
                                FontWeight="Bold"
                                FontSize="12"
                                HorizontalAlignment="Stretch"
                                Padding="10,8"
                                CornerRadius="7"
                                Margin="0,0,0,6"/>

                        <Button Content="📋  View Session Logs"
                                Click="ViewLogsButton_Click"
                                Background="#89DCEB"
                                Foreground="#0F0F17"
                                FontWeight="Bold"
                                FontSize="12"
                                HorizontalAlignment="Stretch"
                                Padding="10,8"
                                CornerRadius="7"
                                Margin="0,0,0,6"/>

                        <Button Content="↺  Refresh"
                                Click="RefreshButton_Click"
                                Background="#252532"
                                Foreground="#9094A8"
                                FontSize="12"
                                HorizontalAlignment="Stretch"
                                Padding="10,8"
                                CornerRadius="7"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ MIDDLE PANEL ══ -->
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="SESSIONS / DAYS"
                           FontSize="10" FontWeight="Bold"
                           Foreground="#45475A"
                           CharacterSpacing="80"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="1"
                        Background="#16161F"
                        CornerRadius="10"
                        Padding="6"
                        Margin="0,0,0,10"
                        BorderBrush="#2A2A3D"
                        BorderThickness="1">
                    <ListView x:Name="SessionsListView"
                              Background="Transparent"
                              SelectionMode="Single"
                              Foreground="#CDD6F4"
                              FontSize="12"
                              DoubleTapped="SessionsListView_DoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#CDD6F4"
                                           FontSize="12"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="SCAN LOG PREVIEW"
                           FontSize="10" FontWeight="Bold"
                           Foreground="#45475A"
                           CharacterSpacing="80"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="3"
                        Background="#16161F"
                        CornerRadius="10"
                        Padding="6"
                        BorderBrush="#2A2A3D"
                        BorderThickness="1">
                    <ListView x:Name="ScanLogListView"
                              Background="Transparent"
                              Foreground="#6C7086"
                              FontSize="11"
                              FontFamily="Consolas"/>
                </Border>
            </Grid>

            <!-- ══ RIGHT PANEL: Activity log ══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="ACTIVITY LOG"
                           FontSize="10" FontWeight="Bold"
                           Foreground="#45475A"
                           CharacterSpacing="80"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="1"
                        Background="#16161F"
                        CornerRadius="10"
                        Padding="6"
                        BorderBrush="#2A2A3D"
                        BorderThickness="1">
                    <ListView x:Name="ActivityLogListView"
                              Background="Transparent"
                              Foreground="#6C7086"
                              FontSize="11"
                              FontFamily="Consolas">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           Foreground="#6C7086"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
