<Window
    x:Class="NFC_System.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Risk-Based NFC Verification System">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">

        <!-- Dynamic Responsive Triggers -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Login Screen Adjustments -->
                        <Setter Target="MainLoginTitle.FontSize" Value="28" />
                        <Setter Target="MainLoginTitle.CharacterSpacing" Value="25" />
                        <Setter Target="MainLoginTitle.Margin" Value="16,0,16,0" />
                        <Setter Target="SetupTitle.FontSize" Value="28" />
                        <Setter Target="SetupTitle.Margin" Value="16,0,16,0" />

                        <!-- Dashboard Header Adjustments -->
                        <Setter Target="DashboardHeaderLeftCol.Width" Value="*" />
                        <Setter Target="DashboardHeaderRightCol.Width" Value="Auto" />
                        <Setter Target="DashboardHeaderMidCol.Width" Value="0" />
                        <Setter Target="DashboardHeaderBottomRow.Height" Value="Auto" />

                        <Setter Target="DashboardTitleStack.(Grid.Row)" Value="1" />
                        <Setter Target="DashboardTitleStack.(Grid.Column)" Value="0" />
                        <Setter Target="DashboardTitleStack.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DashboardTitleStack.Margin" Value="0,24,0,0" />

                        <Setter Target="DashboardTitleText.FontSize" Value="24" />
                        <Setter Target="DashboardSubtitleText.FontSize" Value="13" />
                        <Setter Target="DashboardSubtitleText.TextWrapping" Value="Wrap" />

                        <Setter Target="DashboardContent.Padding" Value="16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- GLOBAL OFFLINE BANNER -->
        <Border Grid.Row="0" x:Name="GlobalOfflineBanner" Background="#DC2626" Padding="16,8" Visibility="Collapsed" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xEE71;" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="SYSTEM OFFLINE: Operating on Local Cache. Scans are being saved locally and will sync when the connection is restored." Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Container for all Overlays -->
        <Grid Grid.Row="1">

            <!-- MAIN DASHBOARD CONTENT -->
            <Grid x:Name="DashboardContent" Padding="24,32,24,24" Background="{StaticResource AppBackgroundBrush}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dynamic Header Layer -->
                <Grid x:Name="DashboardHeaderGrid" Grid.Row="0" Margin="0,0,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="DashboardHeaderBottomRow" Height="0"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DashboardHeaderLeftCol" Width="280"/>
                        <ColumnDefinition x:Name="DashboardHeaderMidCol" Width="*"/>
                        <ColumnDefinition x:Name="DashboardHeaderRightCol" Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="4">
                        <TextBlock Text="LOGGED IN AS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="100"/>
                        <TextBlock x:Name="ActiveRoleText" Text="Administrator" FontSize="16" FontWeight="SemiBold" Foreground="#60A5FA"/>
                        <Button Content="Sign Out" Click="SignOut_Click" Margin="0,8,0,0" Padding="12,6" Background="Transparent" BorderBrush="#30FFFFFF" FontSize="12"/>
                    </StackPanel>

                    <!-- Central Title and Logo -->
                    <StackPanel x:Name="DashboardTitleStack" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Spacing="8">
                        <Border Width="64" Height="64" CornerRadius="16" Background="#1AFFFFFF" HorizontalAlignment="Center">
                            <Viewbox Margin="16">
                                <FontIcon Glyph="&#xEA18;" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </Viewbox>
                        </Border>

                        <TextBlock x:Name="DashboardTitleText" 
                                   Text="Risk-Based Verification System"
                                   Style="{StaticResource PageTitleStyle}"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="DashboardSubtitleText" 
                                   Text="Two-Factor Student Verification and Event Attendance Management"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Settings Trigger Button -->
                    <Button x:Name="DashboardSettingsButton" Grid.Row="0" Grid.Column="2" Click="DashboardSettingsButton_Click" 
                            Width="48" Height="48" CornerRadius="12" Background="#1AFFFFFF" BorderThickness="0" 
                            VerticalAlignment="Top" HorizontalAlignment="Right" ToolTipService.ToolTip="Application Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <!-- Scrollable Main Container -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,0,0,12">
                    <!-- Main Cards Container: 3x2 Grid Layout -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="24" RowSpacing="24" Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ROW 1 -->
                        <!-- 1. Registration Card -->
                        <Button x:Name="RegistrationCard" Grid.Row="0" Grid.Column="0" Click="Registration_Click" Padding="0" BorderThickness="0"
                            Background="Transparent" Height="240" Width="300"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="#1A46A3FF" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="#60A5FA"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                        <TextBlock Text="Registration" Style="{StaticResource CardTitleStyle}" FontSize="20" Margin="0,0,0,8"/>
                                        <TextBlock Text="Register student profiles and configure 2FA credentials (NFC, PIN, and QR)." Style="{StaticResource BodyTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xE72A;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Profiles &amp; 2FA Setup" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 2. Event Attendance Card -->
                        <Button x:Name="EventAttendanceCard" Grid.Row="0" Grid.Column="1" Click="EventAttendance_Click" Padding="0" BorderThickness="0"
                                Background="Transparent" Height="240" Width="300"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="#1A34D399" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <FontIcon Glyph="&#xE787;" FontSize="22" Foreground="#34D399"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                        <TextBlock Text="Event Attendance" Style="{StaticResource CardTitleStyle}" FontSize="20" Margin="0,0,0,8"/>
                                        <TextBlock Text="Validate restricted event eligibility and securely record attendance using risk-based modes." Style="{StaticResource BodyTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xE8D4;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Attendance Tracking" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 3. Verification Card -->
                        <Button x:Name="VerificationCard" Grid.Row="0" Grid.Column="2" Click="Verification_Click" Padding="0" BorderThickness="0"
                            Background="Transparent" Height="240" Width="300"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="#1AA855F7" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <FontIcon Glyph="&#xE73E;" FontSize="22" Foreground="#A855F7"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                        <TextBlock Text="Verification" Style="{StaticResource CardTitleStyle}" FontSize="20" Margin="0,0,0,8"/>
                                        <TextBlock Text="Scan credentials at campus entry points. The system automatically enforces tailgating rules." Style="{StaticResource BodyTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xED35;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Automated Gate" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- ROW 2 -->
                        <!-- 4. Student Directory Card -->
                        <Button x:Name="StudentDirectoryCard" Grid.Row="1" Grid.Column="0" Click="StudentDirectory_Click" Padding="0" BorderThickness="0"
                            Background="Transparent" Height="240" Width="300"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="#1AF59E0B" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <FontIcon Glyph="&#xE822;" FontSize="22" Foreground="#F59E0B"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                        <TextBlock Text="Directory" Style="{StaticResource CardTitleStyle}" FontSize="20" Margin="0,0,0,8"/>
                                        <TextBlock Text="Search student profiles, inspect 2FA authentication states, and manage PIN lockouts." Style="{StaticResource BodyTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Search &amp; Lockouts" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 5. Security Administration Card -->
                        <Button x:Name="SecurityAdminCard" Grid.Row="1" Grid.Column="1" Click="Settings_Click" Padding="0" BorderThickness="0"
                                Background="Transparent" Height="240" Width="300"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="#1AF75555" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <FontIcon Glyph="&#xE713;" FontSize="22" Foreground="#F87171"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                        <TextBlock Text="Security Admin" Style="{StaticResource CardTitleStyle}" FontSize="20" Margin="0,0,0,8"/>
                                        <TextBlock Text="Configure risk modes, manage restricted lists, review real-time alerts, and handle configurations." Style="{StaticResource BodyTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Control &amp; Monitoring" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 6. Event Reports Card -->
                        <Button x:Name="EventReportsCard" Grid.Row="1" Grid.Column="2" Click="EventManagement_Click" Padding="0" BorderThickness="0"
                                Background="Transparent" Height="240" Width="300"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="#1A0EA5E9" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="22" Foreground="#0EA5E9"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                        <TextBlock Text="Reports" Style="{StaticResource CardTitleStyle}" FontSize="20" Margin="0,0,0,8"/>
                                        <TextBlock Text="Review event history, manage restricted attendee rosters, and export audit logs." Style="{StaticResource BodyTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xE7DD;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Audits &amp; Exports" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </Grid>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Text="Taguig City University • Risk-Based Authentication Prototype"
                           Style="{StaticResource BodyTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </Grid>

            <!-- FIRST TIME SETUP OVERLAY -->
            <Grid x:Name="SetupOverlay" Background="#0A0A0A" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="400">
                    <Viewbox MaxHeight="80" Margin="0,0,0,8">
                        <FontIcon Glyph="&#xE713;" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </Viewbox>
                    <TextBlock x:Name="SetupTitle" Text="System Initialization" FontSize="36" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="SetupInstructionText" Text="Please tap an NFC card to register as the Master Administrator." FontSize="16" Foreground="#A0A0A0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>

                    <StackPanel x:Name="SetupFormPanel" Spacing="16" Visibility="Collapsed">
                        <TextBox x:Name="SetupFirstNameBox" Header="First Name" PlaceholderText="e.g. Jane" />
                        <TextBox x:Name="SetupLastNameBox" Header="Last Name" PlaceholderText="e.g. Doe" />
                        <Button x:Name="CompleteSetupButton" Content="Register Master Key" Click="CompleteSetupButton_Click" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" Height="48" Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- Setup Simulator Button -->
                    <Button x:Name="SimulateSetupButton" Content="Simulate NFC Tap" Click="SimulateAdminLogin_Click" Background="#1AFFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF" HorizontalAlignment="Center" Opacity="0.5"/>
                </StackPanel>
            </Grid>

            <!-- LOGIN OVERLAY -->
            <Grid x:Name="LoginOverlay" Background="#0A0A0A" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">

                    <Viewbox MaxHeight="100" Margin="0,0,0,16">
                        <FontIcon Glyph="&#xEA18;" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </Viewbox>

                    <TextBlock x:Name="MainLoginTitle" Text="Risk-Based NFC Verification System" FontSize="48" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" CharacterSpacing="150" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LoginStatusText" Text="Please tap your Staff or Admin NFC ID to log in." FontSize="18" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,0,0,32" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button Click="RefreshComPort_Click" 
                            Background="Transparent" 
                            BorderBrush="Transparent"
                            ToolTipService.ToolTip="Refresh NFC Terminal Connection"
                            HorizontalAlignment="Center" 
                            Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            <TextBlock Text="Refresh Connection" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ProgressRing x:Name="LoginLoadingRing" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Width="40" Height="40" Margin="0,0,0,24"/>

                    <!-- Debug Simulations -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Opacity="0.5">
                        <Button Content="Simulate Master Admin" Click="SimulateAdminLogin_Click" Background="#1AFFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF"/>
                        <!-- THE FIX: Added Simulate Security Admin Button -->
                        <Button Content="Simulate Security Admin" Click="SimulateSecAdminLogin_Click" Background="#1AFFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF"/>
                        <Button Content="Simulate Guard" Click="SimulatePersonnelLogin_Click" Background="#1AFFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- DATABASE CONFIGURATION DIALOG -->
            <ContentDialog x:Name="DbConfigDialog"
                           Title="Database Connection Failed"
                           PrimaryButtonText="Save &amp; Retry"
                           CloseButtonText="Continue Offline"
                           DefaultButton="Primary"
                           CornerRadius="8">
                <StackPanel Spacing="16" Width="350">
                    <TextBlock x:Name="DbErrorTextBlock" Foreground="#F87171" TextWrapping="Wrap" FontSize="13"/>
                    <TextBlock Text="Please enter the correct IPv4 address of your local MySQL server." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="ServerIpTextBox" Header="MySQL Server IP Address" PlaceholderText="e.g., 192.168.1.7 or 127.0.0.1" />
                </StackPanel>
            </ContentDialog>

            <ContentDialog x:Name="AdminAuthDialog"
                           Title="Administrator Authorization Required"
                           CloseButtonText="Cancel"
                           CornerRadius="8">
                <StackPanel Spacing="16" Width="350">
                    <TextBlock x:Name="AdminAuthDescriptionText" Text="This action requires Administrator privileges. Please tap your authorized NFC card to proceed." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>

                    <PasswordBox x:Name="AdminPinBox" Header="Enter 4-Digit Staff PIN" MaxLength="4" PlaceholderText="****" Visibility="Collapsed"/>

                    <Border Background="#1A3B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing IsActive="True" Width="24" Height="24"/>
                            <TextBlock Text="Awaiting Admin NFC tap..." FontWeight="SemiBold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="AuthStatusText" Foreground="#F87171" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </ContentDialog>
        </Grid>
    </Grid>
</Window>