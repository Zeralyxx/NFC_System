<Window
    x:Class="NFC_System.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NFC_System">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,40">
            <Border Width="88"
                    Height="88"
                    CornerRadius="24"
                    Background="#33FFFFFF"
                    HorizontalAlignment="Center">
                <Viewbox Margin="18">
                    <SymbolIcon Symbol="ContactInfo"/>
                </Viewbox>
            </Border>

            <TextBlock Text="NFC Student System"
                       FontSize="46"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Integrated Hybrid Student Verification and Attendance Management"
                       FontSize="18"
                       Opacity="0.75"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- Main Cards -->
        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Registration Card -->
            <Button Grid.Column="0"
                    Click="Registration_Click"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                <Border CornerRadius="28"
                        Padding="36"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#1F2A37"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="18">
                        <Border Width="78" Height="78" CornerRadius="22"
                                HorizontalAlignment="Left"
                                Background="#2246A3FF">
                            <Viewbox Margin="16"><SymbolIcon Symbol="Contact"/></Viewbox>
                        </Border>

                        <TextBlock Text="Registration"
                                   FontSize="32" FontWeight="Bold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Register student information and link each NFC UID to a student record."
                                   FontSize="17" Opacity="0.75" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <FontIcon Glyph="&#xE72A;" FontSize="16"/>
                            <TextBlock Text="Student profiles · NFC enrollment"
                                       FontSize="15" Opacity="0.8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>

            <!-- Verification Management Card -->
            <Button Grid.Column="1"
                    Click="VerificationManagement_Click"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                <Border CornerRadius="28"
                        Padding="36"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#251A36"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="18">
                        <Border Width="78" Height="78" CornerRadius="22"
                                HorizontalAlignment="Left"
                                Background="#22CBA6F7">
                            <Viewbox Margin="16"><SymbolIcon Symbol="People"/></Viewbox>
                        </Border>

                        <TextBlock Text="Verification Management"
                                   FontSize="32" FontWeight="Bold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Create daily sessions, track scan history, and view full logs per day."
                                   FontSize="17" Opacity="0.75" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <FontIcon Glyph="&#xE736;" FontSize="16"/>
                            <TextBlock Text="Sessions · per-day logs · universal viewer"
                                       FontSize="15" Opacity="0.8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>

            <!-- Event Attendance Card -->
            <Button Grid.Column="2"
                    Click="EventManagement_Click"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                <Border CornerRadius="28"
                        Padding="36"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#1A2E22"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="18">
                        <Border Width="78" Height="78" CornerRadius="22"
                                HorizontalAlignment="Left"
                                Background="#2234C759">
                            <Viewbox Margin="16"><SymbolIcon Symbol="Calendar"/></Viewbox>
                        </Border>

                        <TextBlock Text="Event Attendance"
                                   FontSize="32" FontWeight="Bold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Create events, start attendance sessions, and track student participation."
                                   FontSize="17" Opacity="0.75" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <FontIcon Glyph="&#xE787;" FontSize="16"/>
                            <TextBlock Text="Events · attendance log"
                                       FontSize="15" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <TextBlock Text="Taguig City University • NFC Thesis Prototype"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.5"/>
            <Button Content="⚙ Settings"
                    Click="Settings_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1"
                    Foreground="White"
                    Opacity="0.7"
                    Padding="14,8"
                    CornerRadius="8"
                    FontSize="14"/>
        </Grid>
    </Grid>
</Window>
