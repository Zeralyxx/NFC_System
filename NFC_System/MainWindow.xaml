<Window
    x:Class="NFC_System.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NFC_System">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,40">
            <Border Width="88"
                    Height="88"
                    CornerRadius="24"
                    Background="#33FFFFFF"
                    HorizontalAlignment="Center">
                <Viewbox Margin="18">
                    <SymbolIcon Symbol="ContactInfo"/>
                </Viewbox>
            </Border>

            <TextBlock Text="NFC Student System"
                       FontSize="46"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Integrated Hybrid Student Verification and Attendance Management"
                       FontSize="18"
                       Opacity="0.75"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- Main Cards -->
        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Registration Card -->
            <Button Grid.Column="0"
                    Click="Registration_Click"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalAlignment="Stretch">
                <Border CornerRadius="28"
                        Padding="30"
                        MinHeight="260"
                        Background="#1F2A37"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="18" VerticalAlignment="Center">
                        <Border Width="78"
                                Height="78"
                                CornerRadius="22"
                                Background="#2246A3FF">
                            <Viewbox Margin="16">
                                <SymbolIcon Symbol="Contact"/>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="Registration"
                                   FontSize="30"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Register student information and link each NFC UID to a student record."
                                   FontSize="17"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <FontIcon Glyph="&#xE72A;" FontSize="16"/>
                            <TextBlock Text="Student profiles · NFC enrollment"
                                       FontSize="15"
                                       Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>

            <!-- Event Attendance Card -->
            <Button Grid.Column="1"
                    Click="EventAttendance_Click"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalAlignment="Stretch">
                <Border CornerRadius="28"
                        Padding="30"
                        MinHeight="260"
                        Background="#183A25"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="18" VerticalAlignment="Center">
                        <Border Width="78"
                                Height="78"
                                CornerRadius="22"
                                Background="#2234D399">
                            <Viewbox Margin="16">
                                <SymbolIcon Symbol="Calendar"/>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="Event Attendance"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Open the event attendance workflow and validate students for a selected event."
                                   FontSize="17"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <FontIcon Glyph="&#xE8D4;" FontSize="16"/>
                            <TextBlock Text="Event scan - attendance log"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>

            <!-- Verification Card -->
            <Button Grid.Column="2"
                    Click="Verification_Click"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalAlignment="Stretch">
                <Border CornerRadius="28"
                        Padding="30"
                        MinHeight="260"
                        Background="#2B2352"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="18" VerticalAlignment="Center">
                        <Border Width="78"
                                Height="78"
                                CornerRadius="22"
                                Background="#22A855F7">
                            <Viewbox Margin="16">
                                <SymbolIcon Symbol="View"/>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="Verification"
                                   FontSize="30"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Scan NFC tags in real time to verify identity and display access results."
                                   FontSize="17"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                            <TextBlock Text="Live scan · access decision"
                                       FontSize="15"
                                       Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>

            <!-- Security Administration Card -->
            <Button Grid.Column="3"
                    Click="Settings_Click"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalAlignment="Stretch">
                <Border CornerRadius="28"
                        Padding="30"
                        MinHeight="260"
                        Background="#23283A"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="18" VerticalAlignment="Center">
                        <Border Width="78"
                                Height="78"
                                CornerRadius="22"
                                Background="#22F75555">
                            <Viewbox Margin="16">
                                <SymbolIcon Symbol="Setting"/>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="Security Admin"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Create events, approve attendees, reset PINs, and review alerts."
                                   FontSize="17"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <FontIcon Glyph="&#xE713;" FontSize="16"/>
                            <TextBlock Text="Events - alerts - recovery"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="Taguig City University • NFC Thesis Prototype"
                   HorizontalAlignment="Center"
                   Opacity="0.5"
                   Margin="0,30,0,0"/>
    </Grid>
</Window>
