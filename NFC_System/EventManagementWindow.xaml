<Window
    x:Class="NFC_System.EventManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Event Administration">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- THE FIX: TIER 2 RESPONSIVENESS (VISUAL STATE MANAGER) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="16,24" />

                        <!-- Reorganize Header to Stack Vertically -->
                        <Setter Target="HeaderCol1.Width" Value="*" />
                        <Setter Target="HeaderCol2.Width" Value="0" />
                        <Setter Target="HeaderRow2.Height" Value="Auto" />

                        <Setter Target="HeaderTitleStack.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderTitleStack.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderTitleStack.Margin" Value="0,16,0,0" />

                        <!-- Reorganize Main Content to Stack Vertically -->
                        <Setter Target="MainCol1.Width" Value="*" />
                        <Setter Target="MainCol2.Width" Value="0" />
                        <Setter Target="MainRow2.Height" Value="Auto" />
                        <Setter Target="MainContentGrid.ColumnSpacing" Value="0" />
                        <Setter Target="MainContentGrid.RowSpacing" Value="24" />

                        <!-- Push the Right Panel under the Left Panel -->
                        <Setter Target="RightPanel.(Grid.Row)" Value="1" />
                        <Setter Target="RightPanel.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <!-- Row 0: The dynamic Offline Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: The Main Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- GLOBAL OFFLINE BANNER -->
        <Border Grid.Row="0" x:Name="GlobalOfflineBanner" Background="#DC2626" Padding="16,8" Visibility="Collapsed" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xEE71;" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="SYSTEM OFFLINE: Operating on Local Cache. Scans are being saved locally and will sync when the connection is restored." Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid x:Name="ContentRoot" Grid.Row="1" Padding="48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Margin="0,0,0,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="HeaderRow2" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderCol1" Width="Auto"/>
                    <ColumnDefinition x:Name="HeaderCol2" Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top" Margin="0,4,0,0">
                    <Button Content="Back to Dashboard" Padding="16,10" Click="DashboardButton_Click" CornerRadius="{StaticResource ButtonCornerRadius}"/>
                    <Button Content="Back to Attendance" Padding="16,10" Click="BackToAttendanceButton_Click" CornerRadius="{StaticResource ButtonCornerRadius}" Background="#1AFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel x:Name="HeaderTitleStack" Grid.Row="0" Grid.Column="1" Margin="24,0,0,0" Spacing="4">
                    <TextBlock Text="Event Administration" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                    <TextBlock Text="Create new events, manage restricted attendee lists, and review audit logs" Style="{StaticResource BodyTextStyle}" FontSize="16" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MainRow1" Height="*"/>
                    <RowDefinition x:Name="MainRow2" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MainCol1" Width="4*"/>
                    <ColumnDefinition x:Name="MainCol2" Width="6*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="LeftPanel" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                    <StackPanel Spacing="24">

                        <Border Padding="32" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="24">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Create New Event" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                                    <TextBlock Text="Configure a new event session for attendance tracking." Style="{StaticResource BodyTextStyle}"/>
                                </StackPanel>

                                <Grid ColumnSpacing="12" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="EventIdTextBox" Grid.Row="0" Grid.Column="0" Header="Event ID" PlaceholderText="EVT-001"/>
                                    <TextBox x:Name="EventNameTextBox" Grid.Row="0" Grid.Column="1" Header="Event Name" PlaceholderText="Assembly"/>
                                    <!-- THE NEW EVENT CATEGORY DROPDOWN -->
                                    <ComboBox x:Name="EventCategoryComboBox" Grid.Row="1" Grid.ColumnSpan="2" Header="Event Category" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Assembly"/>
                                        <ComboBoxItem Content="Seminar"/>
                                        <ComboBoxItem Content="Sports Fest"/>
                                        <ComboBoxItem Content="Workshop"/>
                                        <ComboBoxItem Content="Other"/>
                                    </ComboBox>
                                    <ComboBox x:Name="EventModeComboBox" Grid.Row="2" Grid.ColumnSpan="2" Header="Required Security Mode" SelectedIndex="2" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Fast (NFC Only)"/>
                                        <ComboBoxItem Content="Standard (NFC + PIN)"/>
                                        <ComboBoxItem Content="High-Security (NFC + PIN + QR)"/>
                                    </ComboBox>
                                    <CheckBox x:Name="RestrictedEventCheckBox" Grid.Row="3" Grid.ColumnSpan="2" Content="Restricted event (Only approved attendees allowed)" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Button x:Name="CreateEventButton" Grid.Row="4" Grid.ColumnSpan="2" Content="Create &amp; Activate Event" Click="CreateEventButton_Click" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="RightPanel" Grid.Column="1" RowSpacing="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="32" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                                    <TextBlock Text="Active Events" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                                    <TextBlock Text="Single-click to select and close an event. Double-click a restricted event to manage its attendee list." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="CloseEventButton" Grid.Column="1" Content="Close Selected Event" Click="CloseEventButton_Click" Background="#30F87171" Foreground="#F87171" BorderThickness="0" FontWeight="SemiBold" IsEnabled="False" VerticalAlignment="Top"/>
                            </Grid>

                            <Border Background="#0AFFFFFF" CornerRadius="8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Event ID" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="Event Name" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="Security" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="Type" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                </Grid>
                            </Border>

                            <ListView x:Name="ActiveEventsListView" SelectionChanged="ActiveEventsListView_SelectionChanged" DoubleTapped="ActiveEventsListView_DoubleTapped" Background="Transparent" CornerRadius="8" MaxHeight="200">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:EventRecord">
                                        <Grid Padding="0,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind EventId}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextStyle}" Foreground="White" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind VerificationMode}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind IsRestrictedText}" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Padding="32" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Administration Logs" Style="{StaticResource CardTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Refresh Logs" Click="RefreshLogsButton_Click" Background="Transparent" BorderThickness="1" BorderBrush="#20FFFFFF" VerticalAlignment="Center"/>
                            </Grid>

                            <ListView Grid.Row="1" x:Name="EventLogsListView" Background="Transparent" Padding="0,0,16,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Overrides ContentDialog boundaries to enable horizontal scrolling grid -->
        <ContentDialog x:Name="AttendeeManagementDialog"
                       CloseButtonText="Done"
                       DefaultButton="Close"
                       CornerRadius="8">

            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">1400</x:Double>
            </ContentDialog.Resources>

            <Grid x:Name="DialogContentContainer" Width="600" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,24">
                    <TextBlock Text="Edit Event Details" FontWeight="SemiBold" FontSize="16"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EditEventNameTextBox" Grid.Column="0" PlaceholderText="Event Name..." HorizontalAlignment="Stretch"/>
                        <Button Content="Update Name" Grid.Column="1" Click="UpdateEventNameButton_Click" Width="120" Height="32" Background="#1AFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                    </Grid>
                </StackPanel>

                <Grid x:Name="AttendeeManagementSection" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,24">
                        <TextBlock Text="Add by Filter (Batch)" FontWeight="SemiBold" FontSize="16"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="CourseComboBox" Grid.Column="0" Header="Course" HorizontalAlignment="Stretch" PlaceholderText="Any Course"/>
                            <ComboBox x:Name="YearComboBox" Grid.Column="1" Header="Year Level" HorizontalAlignment="Stretch" PlaceholderText="Any Year">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5+"/>
                            </ComboBox>

                            <Button Content="Add Batch" Grid.Column="2" Click="AddBatchButton_Click" VerticalAlignment="Bottom" Height="55" Background="{StaticResource PrimaryAccentBrush}" Foreground="White"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,24">
                        <TextBlock Text="Add Individual Student" FontWeight="SemiBold" FontSize="16"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IndividualIdTextBox" Grid.Column="0" PlaceholderText="Enter Student ID..." HorizontalAlignment="Stretch"/>
                            <Button Content="Add Student" Grid.Column="1" Click="AddIndividualButton_Click" Width="120" Height="32"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Background="#05FFFFFF" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Approved Attendees" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="ExpandDialogToggle" Grid.Column="1" Content="⛶ Expand View" Click="ExpandDialogToggle_Click" Background="Transparent" BorderBrush="#30FFFFFF" BorderThickness="1" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchAttendeeTextBox" Grid.Column="0" PlaceholderText="Search name or ID..." TextChanged="SearchAttendeeTextBox_TextChanged" HorizontalAlignment="Stretch"/>
                                    <Rectangle Grid.Column="1" Width="1" Height="20" Fill="#30FFFFFF"/>
                                    <ComboBox x:Name="ViewFilterCourseComboBox" Grid.Column="2" PlaceholderText="Filter Course" HorizontalAlignment="Stretch" SelectionChanged="ViewFilter_SelectionChanged"/>
                                    <ComboBox x:Name="ViewFilterYearComboBox" Grid.Column="3" PlaceholderText="Filter Year" HorizontalAlignment="Stretch" SelectionChanged="ViewFilter_SelectionChanged">
                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="5+"/>
                                    </ComboBox>
                                    <Button Grid.Column="4" Content="Clear" Click="ClearViewFilters_Click" Padding="8,4" Background="Transparent" BorderThickness="1" BorderBrush="#30FFFFFF"/>
                                </Grid>
                            </Grid>

                            <!-- COLLAPSED VIEW: Standard Vertical List -->
                            <ListView x:Name="AttendeesListView" Grid.Row="1" MaxHeight="350" Background="Transparent" CornerRadius="8" HorizontalAlignment="Stretch" Visibility="Visible">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:StudentRecord">
                                        <Grid Padding="0,8" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FullName}" Style="{StaticResource DataValueStyle}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind StudentId}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="•" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind Course}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Tag="{x:Bind StudentId}" Click="RemoveAttendeeButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                                                <FontIcon Glyph="&#xE74D;" Foreground="#F87171" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- EXPANDED VIEW: Horizontal 5-Row Column Grid -->
                            <GridView x:Name="AttendeesGridView" Grid.Row="1" Height="350" Background="Transparent" CornerRadius="8" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="5" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:StudentRecord">
                                        <Grid Width="250" Padding="12,8" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,1" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FullName}" Style="{StaticResource DataValueStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="14"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Bind StudentId}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="-" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind Course}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Tag="{x:Bind StudentId}" Click="RemoveAttendeeButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                                                <FontIcon Glyph="&#xE74D;" Foreground="#F87171" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ContentDialog>

        <!-- ========================================================= -->
        <!-- THE FIX: ADMINISTRATOR AUTHORIZATION INTERCEPT POPUP      -->
        <!-- ========================================================= -->
        <ContentDialog x:Name="AdminAuthDialog"
                       Title="Administrator Authorization Required"
                       CloseButtonText="Cancel"
                       CornerRadius="8">
            <StackPanel Spacing="16" Width="350">
                <TextBlock x:Name="AdminAuthDescriptionText" Text="This action requires Administrator privileges. Please tap your authorized NFC card to proceed." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>

                <PasswordBox x:Name="AdminPinBox" Header="Enter 4-Digit Staff PIN" MaxLength="4" PlaceholderText="****" Visibility="Collapsed"/>

                <Border Background="#1A3B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing IsActive="True" Width="24" Height="24"/>
                        <TextBlock Text="Awaiting Admin NFC tap..." FontWeight="SemiBold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="AuthStatusText" Foreground="#F87171" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>