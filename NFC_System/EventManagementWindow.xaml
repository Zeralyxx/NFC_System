<Window
    x:Class="NFC_System.EventManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Event Administration">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="48" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top" Margin="0,4,0,0">
                <Button Content="Back to Dashboard" Padding="16,10" Click="DashboardButton_Click" CornerRadius="{StaticResource ButtonCornerRadius}"/>
                <Button Content="Back to Attendance" Padding="16,10" Click="BackToAttendanceButton_Click" CornerRadius="{StaticResource ButtonCornerRadius}" Background="#1AFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="4">
                <TextBlock Text="Event Administration" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                <TextBlock Text="Create new events, manage restricted attendee lists, and review audit logs" Style="{StaticResource BodyTextStyle}" FontSize="16"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                <StackPanel Spacing="24">

                    <Border Padding="32" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="24">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Create New Event" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                                <TextBlock Text="Configure a new event session for attendance tracking." Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>

                            <Grid ColumnSpacing="12" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="EventIdTextBox" Grid.Row="0" Grid.Column="0" Header="Event ID" PlaceholderText="EVT-001"/>
                                <TextBox x:Name="EventNameTextBox" Grid.Row="0" Grid.Column="1" Header="Event Name" PlaceholderText="Assembly"/>
                                <ComboBox x:Name="EventModeComboBox" Grid.Row="1" Grid.ColumnSpan="2" Header="Required Security Mode" SelectedIndex="2" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Fast (NFC Only)"/>
                                    <ComboBoxItem Content="Standard (NFC + PIN)"/>
                                    <ComboBoxItem Content="High-Security (NFC + PIN + QR)"/>
                                </ComboBox>
                                <CheckBox x:Name="RestrictedEventCheckBox" Grid.Row="2" Grid.ColumnSpan="2" Content="Restricted event (Only approved attendees allowed)" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Button x:Name="CreateEventButton" Grid.Row="3" Grid.ColumnSpan="2" Content="Create &amp; Activate Event" Click="CreateEventButton_Click" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="32" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Active Events" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                                <TextBlock Text="Click any restricted event to manage its attendee list." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            </StackPanel>
                            <Button x:Name="CloseEventButton" Grid.Column="1" Content="Close Selected Event" Click="CloseEventButton_Click" Background="#30F87171" Foreground="#F87171" BorderThickness="0" FontWeight="SemiBold" IsEnabled="False" VerticalAlignment="Top"/>
                        </Grid>

                        <Border Background="#0AFFFFFF" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Event ID" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Event Name" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="Security" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="Type" Style="{StaticResource DataLabelStyle}" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <ListView x:Name="ActiveEventsListView" SelectionChanged="ActiveEventsListView_SelectionChanged" IsItemClickEnabled="True" ItemClick="ActiveEventsListView_ItemClick" Background="Transparent" CornerRadius="8" MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:EventRecord">
                                    <Grid Padding="0,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind EventId}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextStyle}" Foreground="White" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind VerificationMode}" Style="{StaticResource DataValueStyle}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind IsRestrictedText}" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Padding="32" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Administration Logs" Style="{StaticResource CardTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Refresh Logs" Click="RefreshLogsButton_Click" Background="Transparent" BorderThickness="1" BorderBrush="#20FFFFFF" VerticalAlignment="Center"/>
                        </Grid>

                        <ListView Grid.Row="1" x:Name="EventLogsListView" Background="Transparent" Padding="0,0,16,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <ContentDialog x:Name="AttendeeManagementDialog"
                       CloseButtonText="Done"
                       DefaultButton="Close"
                       CornerRadius="8"
                       MaxWidth="800">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,16,0">

                <StackPanel HorizontalAlignment="Stretch" Spacing="24">

                    <StackPanel Spacing="12">
                        <TextBlock Text="Add by Filter (Batch)" FontWeight="SemiBold" FontSize="16"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="CourseComboBox" Grid.Column="0" Header="Course" HorizontalAlignment="Stretch" PlaceholderText="Any Course"/>
                            <ComboBox x:Name="YearComboBox" Grid.Column="1" Header="Year Level" HorizontalAlignment="Stretch" PlaceholderText="Any Year">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5+"/>
                            </ComboBox>

                            <Button Content="Add Batch" Grid.Column="2" Click="AddBatchButton_Click" VerticalAlignment="Bottom" Height="55" Background="{StaticResource PrimaryAccentBrush}" Foreground="White"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Add Individual Student" FontWeight="SemiBold" FontSize="16"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IndividualIdTextBox" Grid.Column="0" PlaceholderText="Enter Student ID..." HorizontalAlignment="Stretch"/>
                            <Button Content="Add Student" Grid.Column="1" Click="AddIndividualButton_Click" Width="120" Height="32"/>
                        </Grid>
                    </StackPanel>

                    <Border BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Background="#05FFFFFF" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Approved Attendees" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                    <ComboBox x:Name="ViewFilterCourseComboBox" PlaceholderText="Filter Course" Width="140" SelectionChanged="ViewFilter_SelectionChanged"/>
                                    <ComboBox x:Name="ViewFilterYearComboBox" PlaceholderText="Filter Year" MinWidth="110" SelectionChanged="ViewFilter_SelectionChanged">
                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="5+"/>
                                    </ComboBox>
                                    <Button Content="Clear" Click="ClearViewFilters_Click" Padding="8,4" Background="Transparent" BorderThickness="1" BorderBrush="#30FFFFFF"/>
                                </StackPanel>
                            </Grid>

                            <ListView x:Name="AttendeesListView" MaxHeight="300" Background="Transparent" CornerRadius="8" HorizontalAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:StudentRecord">
                                        <Grid Padding="0,8" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FullName}" Style="{StaticResource DataValueStyle}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind StudentId}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="•" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind Course}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Tag="{x:Bind StudentId}" Click="RemoveAttendeeButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                                                <FontIcon Glyph="&#xE74D;" Foreground="#F87171" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>