<Window
    x:Class="NFC_System.RegistrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RegistrationWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="28" RowSpacing="20" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="← Back to Dashboard"
                    Padding="16,10"
                    Click="BackButton_Click"
                    CornerRadius="12"/>

            <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="4">
                <TextBlock Text="NFC Student Registration"
                           FontSize="38"
                           FontWeight="Bold"/>
                <TextBlock Text="Create a student record and bind it to an NFC UID"
                           FontSize="16"
                           Opacity="0.72"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="2.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Form -->
            <Border Grid.Column="0"
                    Padding="24"
                    CornerRadius="24"
                    Background="#1F2A37"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Student Information"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="StudentIdTextBox"
                                 Header="Student ID"
                                 PlaceholderText="e.g. 26-00001"/>

                        <TextBox x:Name="FullNameTextBox"
                                 Header="Full Name"
                                 PlaceholderText="Enter complete name"/>

                        <TextBox x:Name="CourseTextBox"
                                 Header="Course"
                                 PlaceholderText="e.g. BS Computer Science"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     x:Name="YearLevelTextBox"
                                     Header="Year Level"
                                     PlaceholderText="e.g. 3"/>

                            <TextBox Grid.Column="1"
                                     x:Name="SectionTextBox"
                                     Header="Section"
                                     PlaceholderText="e.g. 3A"/>
                        </Grid>

                        <ComboBox x:Name="StatusComboBox"
                                  Header="Status"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Active"/>
                            <ComboBoxItem Content="Inactive"/>
                            <ComboBoxItem Content="Expelled"/>
                        </ComboBox>

                        <Border CornerRadius="16"
                                Padding="16"
                                Background="#182231"
                                Margin="0,6,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="NFC Enrollment"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="NfcUidTextBox"
                                         Header="NFC UID"
                                         IsReadOnly="True"
                                         PlaceholderText="Tap NFC card to capture UID"/>

                                <TextBlock Text="Use “Scan UID” and tap the NFC sticker to bind it to the student."
                                           FontSize="14"
                                           Opacity="0.68"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,10,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    x:Name="ScanUidButton"
                                    Content="Scan UID"
                                    Height="46"
                                    CornerRadius="14"/>

                            <Button Grid.Column="1"
                                    x:Name="ClearButton"
                                    Content="Clear"
                                    Height="46"
                                    CornerRadius="14"/>

                            <Button Grid.Column="2"
                                    x:Name="SaveButton"
                                    Content="Save Student"
                                    Height="46"
                                    CornerRadius="14"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Preview / Log -->
            <Grid Grid.Column="1" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.45*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- Preview -->
                <Border Grid.Row="0"
                        Padding="24"
                        CornerRadius="24"
                        Background="#2B2352"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Registration Preview"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>

                        <Grid Grid.Row="1" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Student Info -->
                            <Border Grid.Column="0"
                                    CornerRadius="20"
                                    Padding="18"
                                    Background="#18000000">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="PreviewTextBlock"
                               Text="Student information will appear here."
                               TextWrapping="Wrap"
                               FontSize="20"
                               LineHeight="30"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Right: Photo -->
                            <Border Grid.Column="1"
                                    CornerRadius="20"
                                    Background="#18000000"
                                    MinHeight="260"
                                    MaxHeight="320">
                                <Grid>
                                    <Viewbox Stretch="Uniform">
                                        <SymbolIcon Symbol="Contact"/>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Logs -->
                <Border Grid.Row="1"
                        Padding="24"
                        CornerRadius="24"
                        Background="#23283A"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Recent UID Logs"
                                       FontSize="26"
                                       FontWeight="SemiBold"/>

                            <Border Grid.Column="1"
                                    Padding="10,4"
                                    CornerRadius="999"
                                    Background="#2246A3FF">
                                <TextBlock Text="Live"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <ListView x:Name="UidLogListView"
                                  Height="300"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>