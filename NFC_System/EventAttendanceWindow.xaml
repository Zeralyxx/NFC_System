<Window
    x:Class="NFC_System.EventAttendanceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="EventAttendanceWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Root fills the entire window -->
    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Grid Padding="24"
              RowSpacing="18"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ Row 0 · Header ══════════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="&#x2190; Back to Events"
                        Padding="16,10"
                        Click="BackButton_Click"
                        CornerRadius="12"/>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="2">
                    <TextBlock Text="Event Attendance"
                               FontSize="34"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="EventNameTextBlock"
                               Text="Event: —"
                               FontSize="14"
                               Opacity="0.65"/>
                    <TextBlock Text="Tap an NFC tag — then press Grant or Deny to log the decision"
                               FontSize="13"
                               Opacity="0.45"/>
                </StackPanel>
            </Grid>

            <!-- ══ Row 1 · Result Banner ═══════════════════════════════════ -->
            <Border Grid.Row="1"
                    Padding="20,14"
                    CornerRadius="20"
                    Background="#2B2352"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            x:Name="ResultBorder"
                            CornerRadius="14"
                            Padding="32,12"
                            MinWidth="300"
                            Background="#FF444444">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="ResultTextBlock"
                                       Text="WAITING FOR NFC TAP"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="ResultSubTextBlock"
                                       Text="Ready to scan"
                                       FontSize="13"
                                       Opacity="0.85"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="NFC UID"
                                       Opacity="0.5" FontSize="14"
                                       VerticalAlignment="Center" Width="80"/>
                            <TextBlock x:Name="UidTextBlock"
                                       Text="-" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Tap Time"
                                       Opacity="0.5" FontSize="14"
                                       VerticalAlignment="Center" Width="80"/>
                            <TextBlock x:Name="ScanTimeTextBlock"
                                       Text="-" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Row 2 · Three-column body ══════════════════════════════ -->
            <Grid Grid.Row="2"
                  ColumnSpacing="18"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Col 0 · Photo ──────────────────────────────────── -->
                <Border Grid.Column="0"
                        CornerRadius="20"
                        Background="#23283A"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Grid RowSpacing="12"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Student Photo"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <Border Grid.Row="1"
                                CornerRadius="14"
                                Background="#14000000"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                                <SymbolIcon x:Name="PhotoPlaceholder"
                                            Symbol="Contact"
                                            Width="80" Height="80"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Opacity="0.3"/>
                                <Image x:Name="StudentPhotoImage"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Col 1 · Student Details + Grant/Deny ──────────── -->
                <Border Grid.Column="1"
                        CornerRadius="20"
                        Background="#1F2A37"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        Padding="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Grid RowSpacing="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Row="0"
                                   Text="Student Details"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <!-- All detail fields -->
                        <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Top">

                            <StackPanel Spacing="3">
                                <TextBlock Text="Full Name" Opacity="0.55" FontSize="13"/>
                                <TextBlock x:Name="StudentNameTextBlock"
                                           Text="-"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Student ID" Opacity="0.55" FontSize="13"/>
                                    <TextBlock x:Name="StudentIdTextBlock"
                                               Text="-" FontSize="19"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Course" Opacity="0.55" FontSize="13"/>
                                    <TextBlock x:Name="CourseTextBlock"
                                               Text="-" FontSize="19" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Year &amp; Section" Opacity="0.55" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="YearLevelTextBlock" Text="-" FontSize="19"/>
                                        <TextBlock Text="&#x2013;" FontSize="19" Opacity="0.4"/>
                                        <TextBlock x:Name="SectionTextBlock" Text="-" FontSize="19"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Enrollment Status" Opacity="0.55" FontSize="13"/>
                                    <Border x:Name="StatusBadge"
                                            Padding="16,8"
                                            CornerRadius="999"
                                            HorizontalAlignment="Left"
                                            Background="#33444444">
                                        <TextBlock x:Name="StatusTextBlock"
                                                   Text="-"
                                                   FontSize="17"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                        </StackPanel>

                        <!-- Divider -->
                        <Border Grid.Row="2"
                                Height="1"
                                Background="#20FFFFFF"
                                Margin="0,20,0,16"/>

                        <!-- Grant / Deny bar -->
                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="1"
                                        Margin="0,0,8,0">
                                <TextBlock Text="Security Decision"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.55"/>
                                <TextBlock Text="Activates after scan"
                                           FontSize="10"
                                           Opacity="0.32"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Name="GrantButton"
                                    Click="GrantButton_Click"
                                    IsEnabled="False"
                                    HorizontalAlignment="Stretch"
                                    Height="52"
                                    CornerRadius="12">
                                <Button.Background>
                                    <SolidColorBrush Color="#1E7B34"/>
                                </Button.Background>
                                <Button.Foreground>
                                    <SolidColorBrush Color="White"/>
                                </Button.Foreground>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="✔" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="GRANT ACCESS" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    x:Name="DenyButton"
                                    Click="DenyButton_Click"
                                    IsEnabled="False"
                                    HorizontalAlignment="Stretch"
                                    Height="52"
                                    CornerRadius="12">
                                <Button.Background>
                                    <SolidColorBrush Color="#9B1C1C"/>
                                </Button.Background>
                                <Button.Foreground>
                                    <SolidColorBrush Color="White"/>
                                </Button.Foreground>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="✘" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="DENY ACCESS" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                    </Grid>
                </Border>

                <!-- ── Col 2 · Attendance Log ─────────────────────────── -->
                <Border Grid.Column="2"
                        CornerRadius="20"
                        Background="#23283A"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        Padding="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Grid RowSpacing="14"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Attendance Log"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>

                            <Border Grid.Column="1"
                                    Padding="10,4"
                                    CornerRadius="999"
                                    Background="#22A855F7">
                                <TextBlock Text="Live" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                        </Grid>

                        <ListView Grid.Row="1"
                                  x:Name="AttendanceLogListView"
                                  SelectionMode="None"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>
