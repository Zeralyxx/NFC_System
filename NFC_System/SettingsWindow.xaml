<Window
    x:Class="NFC_System.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Application Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="32" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Configuration" Style="{StaticResource PageTitleStyle}" FontSize="28"/>
            <TextBlock Text="Manage hardware devices, preferences, and system parameters." Style="{StaticResource BodyTextStyle}" Opacity="0.8"/>
        </StackPanel>

        <!-- Main Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Padding="0,0,16,0">

                <!-- Hardware & Devices Card -->
                <Border Padding="24" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Hardware &amp; Peripherals" Style="{StaticResource CardTitleStyle}" FontSize="18"/>

                        <!-- NFC Reader Settings -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse x:Name="NfcStatusIndicator" Grid.Column="0" Width="12" Height="12" Fill="ForestGreen" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="NFC Serial Reader" Style="{StaticResource DataValueStyle}"/>
                                <TextBlock Text="Active on COM3 (9600 baud)" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                            </StackPanel>
                            <ComboBox x:Name="ComPortComboBox" Grid.Column="2" Width="120" SelectedIndex="0" VerticalAlignment="Center">
                                <ComboBoxItem Content="COM3"/>
                                <ComboBoxItem Content="COM4"/>
                                <ComboBoxItem Content="Auto-Detect"/>
                            </ComboBox>
                        </Grid>

                        <Rectangle Height="1" Fill="#10FFFFFF" Margin="0,4"/>

                        <!-- Camera Settings -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse x:Name="CameraStatusIndicator" Grid.Column="0" Width="12" Height="12" Fill="Firebrick" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="QR Capture Device" Style="{StaticResource DataValueStyle}"/>
                                <TextBlock Text="External USB HD Camera (Disconnected)" Style="{StaticResource BodyTextStyle}" FontSize="12" Foreground="Firebrick"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="CameraToggle" Grid.Column="2" IsOn="False" OnContent="Enabled" OffContent="Disabled" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Appearance & Interface Card -->
                <Border Padding="24" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Appearance &amp; Interface" Style="{StaticResource CardTitleStyle}" FontSize="18"/>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Application Theme" Style="{StaticResource DataValueStyle}"/>
                                <TextBlock Text="Override system default colors" Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                            </StackPanel>
                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Width="140" SelectedIndex="0" VerticalAlignment="Center">
                                <ComboBoxItem Content="Dark Mode"/>
                                <ComboBoxItem Content="Light Mode"/>
                                <ComboBoxItem Content="System Default"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons Footer -->
        <Grid Grid.Row="2" Margin="0,24,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton" Grid.Column="0" Content="Cancel" Click="CancelButton_Click" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="#30FFFFFF"/>
            <Button x:Name="SaveButton" Grid.Column="1" Content="Save Changes" Click="SaveButton_Click" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>