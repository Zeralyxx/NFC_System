<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NFC_System.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,36">
            <TextBlock Text="Settings"
                       FontSize="36" FontWeight="Bold"/>
            <TextBlock Text="Configure NFC reader COM ports for each station."
                       FontSize="16" Opacity="0.6"/>
        </StackPanel>

        <!-- Reader 1: Verification (Main Entrance) -->
        <Border Grid.Row="1"
                Background="#1F2A37"
                CornerRadius="16"
                Padding="28"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="12" Height="12" CornerRadius="6"
                                Background="#46A3FF" VerticalAlignment="Center"/>
                        <TextBlock Text="Reader 1 — Main Entrance"
                                   FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="Used for student verification (campus entry)"
                               FontSize="14" Opacity="0.6" Margin="22,0,0,0"/>
                </StackPanel>

                <ComboBox x:Name="VerificationPortComboBox"
                          Grid.Column="1"
                          PlaceholderText="Select port…"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          FontFamily="Consolas"
                          FontSize="15"/>

                <Border Grid.Column="2"
                        x:Name="VerificationStatusDot"
                        Width="14" Height="14" CornerRadius="7"
                        Background="Gray"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Connection status"/>
            </Grid>
        </Border>

        <!-- Reader 2: Event Attendance (Auditorium) -->
        <Border Grid.Row="2"
                Background="#1A2E22"
                CornerRadius="16"
                Padding="28"
                Margin="0,0,0,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="12" Height="12" CornerRadius="6"
                                Background="#34C759" VerticalAlignment="Center"/>
                        <TextBlock Text="Reader 2 — Auditorium / Event Entrance"
                                   FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="Used for event attendance scanning"
                               FontSize="14" Opacity="0.6" Margin="22,0,0,0"/>
                </StackPanel>

                <ComboBox x:Name="EventPortComboBox"
                          Grid.Column="1"
                          PlaceholderText="Select port…"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          FontFamily="Consolas"
                          FontSize="15"/>

                <Border Grid.Column="2"
                        x:Name="EventStatusDot"
                        Width="14" Height="14" CornerRadius="7"
                        Background="Gray"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Connection status"/>
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="12">
            <Button x:Name="TestPortsButton"
                    Content="Test Connections"
                    Click="TestPortsButton_Click"
                    Background="#313244"
                    Foreground="White"
                    Padding="20,12"
                    CornerRadius="10"
                    FontSize="15"/>

            <Button x:Name="SaveButton"
                    Content="Save Settings"
                    Click="SaveButton_Click"
                    Background="#46A3FF"
                    Foreground="#0D0D0D"
                    FontWeight="Bold"
                    Padding="20,12"
                    CornerRadius="10"
                    FontSize="15"/>

            <Button Content="← Back to Dashboard"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1"
                    Foreground="White"
                    Padding="20,12"
                    CornerRadius="10"
                    FontSize="15"/>
        </StackPanel>

        <!-- Status log -->
        <Border Grid.Row="4"
                Background="#12121A"
                CornerRadius="12"
                Padding="16"
                Margin="0,24,0,0">
            <ListView x:Name="StatusLogListView"
                      Background="Transparent"
                      Foreground="#A6ADC8"
                      FontFamily="Consolas"
                      FontSize="13"/>
        </Border>
    </Grid>
</Window>
