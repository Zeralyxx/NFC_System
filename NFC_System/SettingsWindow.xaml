<Window
    x:Class="NFC_System.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Application Settings"
    >

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="32" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Configuration" Style="{StaticResource PageTitleStyle}" FontSize="28"/>
            <TextBlock Text="Manage server connection and system parameters." Style="{StaticResource BodyTextStyle}" Opacity="0.8"/>
        </StackPanel>

        <!-- Network Configuration Card -->
        <Border Grid.Row="1" Padding="24" CornerRadius="{StaticResource CardCornerRadius}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1">
            <StackPanel Spacing="20">
                <TextBlock Text="Network Configuration" Style="{StaticResource CardTitleStyle}" FontSize="18"/>
                <TextBlock Text="Set the IPv4 address of the local MySQL server this station connects to." Style="{StaticResource BodyTextStyle}" FontSize="12" TextWrapping="Wrap"/>

                <TextBox x:Name="ServerIpConfigTextBox"
                         Header="MySQL Server IP Address"
                         PlaceholderText="e.g., 192.168.1.7 or 127.0.0.1"/>

                <TextBlock x:Name="ServerIpStatusText"
                           Text=""
                           FontSize="12"
                           Foreground="#34D399"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons Footer -->
        <Grid Grid.Row="2" Margin="0,24,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton" Grid.Column="0" Content="Cancel" Click="CancelButton_Click" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="#30FFFFFF"/>
            <Button x:Name="SaveButton" Grid.Column="1" Content="Save Changes" Click="SaveButton_Click" Height="44" CornerRadius="{StaticResource ButtonCornerRadius}" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>