<Application
    x:Class="NFC_System.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ========================================== -->
            <!-- 1. COLOR PALETTE (Dark Theme Foundation)   -->
            <!-- ========================================== -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#18181C"/>
            <!-- Deepest background -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#22232A"/>
            <!-- Slightly lighter for UI panels -->
            <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#5A55D1"/>
            <!-- Purple accent -->

            <!-- Semantic Colors (Pass, Fail, Warning) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B57"/>
            <!-- Green for Access Granted -->
            <SolidColorBrush x:Key="DangerBrush" Color="#D93838"/>
            <!-- Red for Access Denied / Alerts -->
            <SolidColorBrush x:Key="WarningBrush" Color="#FF8C00"/>
            <!-- Orange for No Active Events/Waiting -->

            <!-- Text Colors -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A3A8"/>

            <!-- ========================================== -->
            <!-- 2. SHAPES & SPACING                        -->
            <!-- ========================================== -->
            <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>

            <Thickness x:Key="StandardPadding">16</Thickness>
            <Thickness x:Key="CardMargin">8</Thickness>

            <!-- ========================================== -->
            <!-- 3. TYPOGRAPHY (Text Styles)                -->
            <!-- ========================================== -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Style>

            <Style x:Key="DataLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Width" Value="120"/>
                <!-- Keeps columns aligned in your detail cards -->
            </Style>

            <Style x:Key="DataValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>