<UserControl x:Class="NFC_System.RemoteAdministrationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark" Foreground="White">
    <UserControl.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#22232A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#52525B"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#22232A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#52525B"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="#22232A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#52525B"/></Style>
        <Style TargetType="ListView"><Setter Property="Background" Value="#17181D"/><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="InfoBar"><Setter Property="Background" Value="#20252B"/><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#30313A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#52525B"/></Style>
        <Style TargetType="ToggleButton"><Setter Property="Background" Value="#30313A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#52525B"/></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="24" MaxWidth="1160" HorizontalAlignment="Stretch">
            <TextBlock x:Name="PageTitle" Text="Remote Administration" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBox x:Name="SiteIdBox" Header="Main Server ID" IsReadOnly="True" TextWrapping="Wrap"/>
            <StackPanel x:Name="SignInPanel" Spacing="12" MaxWidth="500" HorizontalAlignment="Left">
                <TextBox x:Name="EmailBox" Header="Cloud account email" MaxLength="150"/>
                <PasswordBox x:Name="PasswordBox" Header="Cloud account password"/>
                <Button x:Name="SignInButton" Content="Sign In" Click="SignIn_Click"/>
            </StackPanel>
            <TextBox x:Name="AccountUidBox" Header="Cloud account UID" IsReadOnly="True" Visibility="Collapsed" TextWrapping="Wrap"/>
            <CommandBar x:Name="AccountCommands" Background="Transparent" DefaultLabelPosition="Right" Visibility="Collapsed">
                <AppBarButton Icon="Refresh" Label="Synchronize" Click="Synchronize_Click" ToolTipService.ToolTip="Synchronize changes and confirmations"/>
                <AppBarButton Icon="Mail" Label="Verify Email" Click="VerifyEmail_Click" ToolTipService.ToolTip="Send an email verification link"/>
                <AppBarButton Icon="Switch" Label="Sign Out" Click="SignOut_Click" ToolTipService.ToolTip="Sign out of this cloud account"/>
            </CommandBar>
            <ProgressBar x:Name="WorkingBar" IsIndeterminate="True" Visibility="Collapsed"/>
            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Cloud sign-in required"/>
            <ContentControl x:Name="ServerPanel" HorizontalContentAlignment="Stretch" Visibility="Collapsed"><StackPanel Spacing="12">
                <TextBlock Text="Administrator Access" FontSize="18" FontWeight="SemiBold"/>
                <Button Content="Refresh Accounts" Click="RefreshMembers_Click"/>
                <ListView x:Name="MembersList" Height="160" SelectionChanged="Member_Changed">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <TextBox x:Name="MemberUidBox" Header="Administrator cloud account UID" MaxLength="128"/>
                <TextBox x:Name="MemberEmailBox" Header="Administrator email" MaxLength="150"/>
                <TextBox x:Name="MemberNameBox" Header="Administrator name" MaxLength="100"/>
                <ComboBox x:Name="MemberStateBox" Header="Access" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Approved"/><ComboBoxItem Content="Revoked"/>
                </ComboBox>
                <Button Content="Save Account Access" Click="SaveMember_Click"/>
                <Button Content="Stop Server Cloud Connection" Click="StopServer_Click"/>
                <TextBlock x:Name="ServerStatusText" TextWrapping="Wrap"/>
            </StackPanel></ContentControl>
            <ContentControl x:Name="RemotePanel" HorizontalContentAlignment="Stretch" Visibility="Collapsed"><StackPanel Spacing="16">
                <TextBlock Text="Students" FontSize="18" FontWeight="SemiBold"/>
                <TextBox x:Name="SearchBox" Header="Search" TextChanged="Search_Changed"/>
                <ListView x:Name="StudentsList" Height="220" SelectionChanged="Student_Changed">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                    <AppBarButton Icon="Add" Label="New Student" Click="NewStudent_Click" ToolTipService.ToolTip="Create a student profile"/>
                    <AppBarButton Icon="Save" Label="Submit Change" Click="Submit_Click" ToolTipService.ToolTip="Queue this change for the main server"/>
                    <AppBarButton Icon="Scan" Label="Student QR" Click="ShowQr_Click" ToolTipService.ToolTip="View or export the server-issued student QR"/>
                </CommandBar>
                <TextBlock x:Name="EditorState" Text="New student" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <Grid x:Name="EditorGrid" ColumnSpacing="20" RowSpacing="16" SizeChanged="Editor_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="12">
                        <TextBox x:Name="StudentIdBox" Header="Student ID" MaxLength="50"/>
                        <TextBox x:Name="FullNameBox" Header="Full name" MaxLength="100"/>
                        <TextBox x:Name="StudentEmailBox" Header="Email" MaxLength="150"/>
                        <TextBox x:Name="CourseBox" Header="Course" MaxLength="100"/>
                        <TextBox x:Name="YearBox" Header="Year level" MaxLength="20"/>
                        <TextBox x:Name="SectionBox" Header="Section" MaxLength="50"/>
                    </StackPanel>
                    <StackPanel x:Name="CredentialFields" Grid.Column="1" Spacing="12">
                        <ComboBox x:Name="EnrollmentBox" Header="Enrollment status" SelectedIndex="4" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Active"/><ComboBoxItem Content="Inactive"/><ComboBoxItem Content="Graduated"/>
                            <ComboBoxItem Content="Expelled"/><ComboBoxItem Content="Pending Enrollment"/>
                        </ComboBox>
                        <TextBox x:Name="NfcUidBox" Header="NFC UID" MaxLength="50"/>
                        <ComboBox x:Name="ComPortBox" Header="NFC reader port" HorizontalAlignment="Stretch"/>
                        <ToggleButton x:Name="ScanCardButton" Content="Read NFC Card" Click="ScanCard_Click"/>
                        <PasswordBox x:Name="NewPinBox" Header="New or replacement PIN" MaxLength="4"/>
                        <CheckBox x:Name="ReissueQrBox" Content="Issue replacement QR"/>
                        <CheckBox x:Name="TemporaryBox" Content="Temporary badge"/>
                        <Button Content="Choose Student Photo" Click="ChoosePhoto_Click"/>
                        <TextBlock x:Name="PhotoStatus" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="ReasonBox" Header="Reason for change" MaxLength="1000" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70"/>
                <TextBlock Text="Change Requests" FontSize="18" FontWeight="SemiBold"/>
                <ListView x:Name="RequestsList" Height="230">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </StackPanel></ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
