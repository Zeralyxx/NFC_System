<Window
    x:Class="NFC_System.VerificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="VerificationWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="28" RowSpacing="20" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & State Controllers -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Back" Padding="16,10" Click="BackButton_Click" CornerRadius="12"/>

            <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="4">
                <TextBlock Text="Automated Verification Gate" FontSize="38" FontWeight="Bold"/>
                <TextBlock Text="System independently validates credentials based on risk mode" FontSize="16" Opacity="0.72"/>
            </StackPanel>

            <!-- NEW: Security Mode & Anti-Tailgating Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ComboBox x:Name="DirectionComboBox" Header="Transaction Type" SelectedIndex="0" Width="170">
                    <ComboBoxItem Content="Entry"/>
                    <ComboBoxItem Content="Exit"/>
                    <ComboBoxItem Content="Event Attendance"/>
                </ComboBox>
                <ComboBox x:Name="SecurityModeComboBox" Header="Current Security Mode" SelectedIndex="2" Width="200">
                    <ComboBoxItem Content="Fast (NFC Only)"/>
                    <ComboBoxItem Content="Standard (NFC + PIN)"/>
                    <ComboBoxItem Content="High-Security (NFC+PIN+QR)"/>
                </ComboBox>
                <TextBox x:Name="EventIdTextBox" Header="Event ID" PlaceholderText="For attendance" Width="160"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side: Result & Details -->
            <Grid Grid.Column="0" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Pass/Fail Result Engine -->
                <Border Grid.Row="0" Padding="24" CornerRadius="24" Background="#2B2352" BorderBrush="#30FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Automated Decision Engine" FontSize="28" FontWeight="SemiBold"/>
                        <Border x:Name="ResultBorder" CornerRadius="22" Padding="28" Background="#FF444444">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <TextBlock x:Name="ResultTextBlock" Text="AWAITING NFC TAP" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock x:Name="ResultSubTextBlock" Text="System Ready" FontSize="16" Opacity="0.8" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Student Details & Entry State -->
                <Border Grid.Row="1" Padding="24" CornerRadius="24" Background="#1F2A37" BorderBrush="#30FFFFFF" BorderThickness="1">
                    <Grid RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Student Details" FontSize="30" FontWeight="SemiBold"/>

                        <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="StudentNameTextBlock" Grid.Row="0" Grid.Column="1" Text="-" FontSize="28" FontWeight="Bold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Student ID" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="StudentIdTextBlock" Grid.Row="1" Grid.Column="1" Text="-" FontSize="22"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Course" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="CourseTextBlock" Grid.Row="2" Grid.Column="1" Text="-" FontSize="22"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Year Level" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="YearLevelTextBlock" Grid.Row="3" Grid.Column="1" Text="-" FontSize="20"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Section" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="SectionTextBlock" Grid.Row="4" Grid.Column="1" Text="-" FontSize="20"/>

                            <!-- Enrollment Status -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Enrollment" Opacity="0.72" FontSize="17"/>
                            <Border x:Name="StatusBadge" Grid.Row="5" Grid.Column="1" Padding="12,6" CornerRadius="999" HorizontalAlignment="Left" Background="#33444444">
                                <TextBlock x:Name="StatusTextBlock" Text="-" FontSize="18" FontWeight="Bold"/>
                            </Border>

                            <!-- NEW: Anti-Tailgating State -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Current State" Opacity="0.72" FontSize="17"/>
                            <Border Grid.Row="6" Grid.Column="1" Padding="12,6" CornerRadius="999" HorizontalAlignment="Left" Background="#331D4ED8">
                                <TextBlock x:Name="EntryStateTextBlock" Text="Unknown (Wait for scan)" FontSize="18" FontWeight="Bold"/>
                            </Border>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="NFC UID" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="UidTextBlock" Grid.Row="7" Grid.Column="1" Text="-" FontSize="18" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Last Audit Scan" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="ScanTimeTextBlock" Grid.Row="8" Grid.Column="1" Text="-" FontSize="20"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Side: 2FA & Logs -->
            <Grid Grid.Column="1" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- NEW: Secondary Authentication Block -->
                <Border Grid.Row="0" Padding="24" CornerRadius="24" Background="#23283A" BorderBrush="#30FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Secondary Authentication (2FA)" FontSize="26" FontWeight="SemiBold"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ManualUidTextBox" Header="Manual NFC UID" PlaceholderText="Use when the reader is offline" Grid.Column="0"/>
                            <Button x:Name="ProcessManualUidButton" Content="Process UID" Grid.Column="1" Height="44" Margin="0,28,0,0" CornerRadius="8"/>
                        </Grid>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- PIN Input (Standard/High Mode) -->
                            <StackPanel Grid.Column="0" Spacing="10">
                                <TextBlock Text="1. PIN Entry" FontSize="18" Opacity="0.8"/>
                                <PasswordBox x:Name="VerifyPinBox" FontSize="24" MaxLength="4" PlaceholderText="Enter PIN" IsEnabled="False" HorizontalAlignment="Stretch"/>
                                <Button x:Name="SubmitPinButton" Content="Submit PIN" HorizontalAlignment="Stretch" CornerRadius="8" IsEnabled="False"/>
                            </StackPanel>

                            <!-- QR Scanner (High Mode) -->
                            <StackPanel Grid.Column="1" Spacing="10">
                                <TextBlock Text="2. QR Validation" FontSize="18" Opacity="0.8"/>
                                <Border Height="120" CornerRadius="12" Background="#18000000" BorderBrush="#30FFFFFF" BorderThickness="1">
                                    <!-- This will house your ZXing WebCam feed -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE714;" FontSize="30" Opacity="0.5"/>
                                        <TextBlock Text="Decoded QR" Opacity="0.5" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBox x:Name="QrCredentialTextBox" PlaceholderText="Paste scanned QR payload" IsEnabled="False"/>
                                <Button x:Name="SubmitQrButton" Content="Validate QR" HorizontalAlignment="Stretch" CornerRadius="8" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Audit Logs (Alerts go here) -->
                <Border Grid.Row="1" Padding="24" CornerRadius="24" Background="#1A1F2E" BorderBrush="#30FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Security &amp; Tailgating Alerts" FontSize="26" FontWeight="SemiBold"/>
                            <Border Grid.Column="1" Padding="10,4" CornerRadius="999" Background="#22F75555">
                                <TextBlock Text="Monitoring" FontWeight="SemiBold" Foreground="#F75555"/>
                            </Border>
                        </Grid>
                        <!-- Will display: [MISMATCH], [TAILGATING], [ACCESS GRANTED] -->
                        <ListView x:Name="VerificationLogListView" Height="300"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
