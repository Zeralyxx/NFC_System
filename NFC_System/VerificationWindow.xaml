<Window
    x:Class="NFC_System.VerificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NFC_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="VerificationWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="28" RowSpacing="20" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="← Back to Dashboard"
                    Padding="16,10"
                    Click="BackButton_Click"
                    CornerRadius="12"/>

            <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="4">
                <TextBlock Text="NFC Student Verification"
                           FontSize="38"
                           FontWeight="Bold"/>
                <TextBlock Text="Tap an NFC tag to verify identity and display the access result"
                           FontSize="16"
                           Opacity="0.72"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side -->
            <Grid Grid.Column="0" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Result -->
                <Border Grid.Row="0"
                        Padding="24"
                        CornerRadius="24"
                        Background="#2B2352"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Verification Result"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>

                        <Border x:Name="ResultBorder"
                                CornerRadius="22"
                                Padding="28"
                                Background="#FF444444">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <TextBlock x:Name="ResultTextBlock"
                                           Text="WAITING FOR NFC TAP"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="ResultSubTextBlock"
                                           Text="Ready to scan"
                                           FontSize="16"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Student Details -->
                <Border Grid.Row="1"
                        Padding="24"
                        CornerRadius="24"
                        Background="#1F2A37"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <Grid RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Student Details"
                                   FontSize="30"
                                   FontWeight="SemiBold"/>

                        <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="StudentNameTextBlock" Grid.Row="0" Grid.Column="1" Text="-" FontSize="28" FontWeight="Bold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Student ID" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="StudentIdTextBlock" Grid.Row="1" Grid.Column="1" Text="-" FontSize="22"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Course" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="CourseTextBlock" Grid.Row="2" Grid.Column="1" Text="-" FontSize="22"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Year Level" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="YearLevelTextBlock" Grid.Row="3" Grid.Column="1" Text="-" FontSize="22"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Section" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="SectionTextBlock" Grid.Row="4" Grid.Column="1" Text="-" FontSize="22"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Status" Opacity="0.72" FontSize="17"/>
                            <Border x:Name="StatusBadge"
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Padding="12,6"
                                    CornerRadius="999"
                                    HorizontalAlignment="Left"
                                    Background="#33444444">
                                <TextBlock x:Name="StatusTextBlock"
                                           Text="-"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                            </Border>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="NFC UID" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="UidTextBlock" Grid.Row="6" Grid.Column="1" Text="-" FontSize="20"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Last Scan" Opacity="0.72" FontSize="17"/>
                            <TextBlock x:Name="ScanTimeTextBlock" Grid.Row="7" Grid.Column="1" Text="-" FontSize="20"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Side -->
            <Grid Grid.Column="1" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Photo -->
                <Border Grid.Row="0"
                        Padding="24"
                        CornerRadius="24"
                        Background="#23283A"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Student Photo"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <Border Height="260"
                                CornerRadius="20"
                                Background="#18000000">
                            <Grid>
                                <SymbolIcon Symbol="Contact"
                                            Width="140"
                                            Height="140"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Logs -->
                <Border Grid.Row="1"
                        Padding="24"
                        CornerRadius="24"
                        Background="#23283A"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Recent Verification Logs"
                                       FontSize="26"
                                       FontWeight="SemiBold"/>

                            <Border Grid.Column="1"
                                    Padding="10,4"
                                    CornerRadius="999"
                                    Background="#22A855F7">
                                <TextBlock Text="Live"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <ListView x:Name="VerificationLogListView"
                                  Height="430"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>